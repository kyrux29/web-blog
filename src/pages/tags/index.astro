---
import { getTagCounts } from "../../lib/content";
import { withBase } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const tags = await getTagCounts();
---

<BaseLayout title="Tags | Kyrux">
  <section class="mb-8 pt-4">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100">Tags</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Browse techniques, platforms, and topics across CTF write-ups and research notes.
    </p>
  </section>

  <div class="glass-panel p-6">
    <div class="flex flex-wrap gap-2">
      {tags.map(({ tag, count }) => (
        <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)} class="chip hover:text-cyan-300 hover:border-cyan-500/20 transition-all">
          {tag} <span class="ml-1.5 text-[10px] text-neutral-500">({count})</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
