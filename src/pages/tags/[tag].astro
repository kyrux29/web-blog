---
import { getPublishedBlogPosts, getPublishedCtfPosts } from "../../lib/content";
import { withBase, difficultyChipClass } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const blog = await getPublishedBlogPosts();
  const ctf = await getPublishedCtfPosts();
  const tagSet = new Set<string>();
  for (const entry of [...blog, ...ctf]) {
    for (const tag of entry.data.tags ?? []) tagSet.add(String(tag));
  }
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props as { tag: string };

const blog = (await getPublishedBlogPosts()).filter((e) =>
  (e.data.tags ?? []).includes(tag)
);
const ctf = (await getPublishedCtfPosts()).filter((e) =>
  (e.data.tags ?? []).includes(tag)
);

const sortByDateDesc = (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf();
blog.sort(sortByDateDesc);
ctf.sort(sortByDateDesc);
---

<BaseLayout title={`Tag: ${tag} | Kyrux`}>
  <section class="mb-6">
    <p class="chip mb-3">Tag</p>
    <h1 class="text-4xl font-semibold tracking-tight text-neutral-100">{tag}</h1>
    <p class="mt-3 max-w-3xl text-neutral-400">
      {ctf.length} CTF write-ups · {blog.length} blog posts
    </p>
    <div class="mt-4">
      <a href={withBase("/tags/")} class="text-sm text-cyan-300 hover:text-cyan-200">← All tags</a>
    </div>
  </section>

  {ctf.length > 0 && (
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold text-neutral-100">CTF</h2>
      <ul class="space-y-4">
        {ctf.map((entry) => (
          <li class="panel p-5">
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="chip">{entry.data.date.toLocaleDateString("en-CA")}</span>
              <span class="chip">{entry.data.platform}</span>
              {entry.data.difficulty && <span class={`chip ${difficultyChipClass(entry.data.difficulty)}`}>{entry.data.difficulty}</span>}
            </div>
            <a href={withBase(`/ctf/${entry.id}/`)} class="text-2xl font-medium leading-tight text-neutral-100 hover:text-cyan-300">
              {entry.data.title}
            </a>
            <p class="mt-3 text-sm text-neutral-400">{entry.data.vulnerability_type ?? entry.data.category ?? ""}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {blog.length > 0 && (
    <section>
      <h2 class="mb-4 text-xl font-semibold text-neutral-100">Blog</h2>
      <ul class="space-y-4">
        {blog.map((entry) => (
          <li class="panel p-5">
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="chip">{entry.data.date.toLocaleDateString("en-CA")}</span>
              <span class="chip">Research</span>
            </div>
            <a href={withBase(`/blog/${entry.id}/`)} class="text-2xl font-medium leading-tight text-neutral-100 hover:text-cyan-300">
              {entry.data.title}
            </a>
            <p class="mt-3 text-sm text-neutral-400">{entry.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
