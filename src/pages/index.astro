---
import { getPublishedBlogPosts, getPublishedCtfPosts } from "../lib/content";
import { estimateReadingTime, withBase } from "../utils";
import BaseLayout from "../layouts/BaseLayout.astro";

const latestCtf = (await getPublishedCtfPosts()).slice(0, 3);
const latestBlogs = (await getPublishedBlogPosts()).slice(0, 3);
---

<BaseLayout title="Kyrux | Cyber Security Research Blog">
  <section class="mb-10">
    <p class="mb-2 font-mono text-[11px] tracking-[0.25em] text-neutral-600">
      [kyrux@labs ~]$ whoami
    </p>
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100 sm:text-5xl md:text-6xl">
      Kyrux
    </h1>
    <p class="mt-4 max-w-xl font-mono text-sm leading-6 text-neutral-400">
      Web exploitation & CTF write-ups.
    </p>
  </section>

  <section class="reveal mb-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-mono text-sm text-neutral-400">
        <span class="text-cyan-400">~/ctf</span>
      </h2>
      <a href={withBase("/ctf/")} class="font-mono text-xs text-neutral-600 hover:text-cyan-400">all →</a>
    </div>
    <ul class="space-y-2">
      {latestCtf.map((entry) => (
        <li class="group rounded-lg border border-neutral-900 bg-neutral-950 px-4 py-3 hover:border-neutral-800">
          <a href={withBase(`/ctf/${entry.id}/`)} class="text-sm font-medium text-neutral-300 group-hover:text-cyan-300">
            {entry.data.title}
          </a>
          <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[10px] tracking-wide text-neutral-600">
            <span>{entry.data.platform}</span>
            <span class="text-neutral-800">·</span>
            <span>{entry.data.vulnerability_type || entry.data.category}</span>
            {entry.data.difficulty && (
              <>
                <span class="text-neutral-800">·</span>
                <span class={`chip chip--${entry.data.difficulty.toLowerCase()}`}>{entry.data.difficulty}</span>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="reveal">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-mono text-sm text-neutral-400">
        <span class="text-cyan-400">~/blog</span>
      </h2>
      <a href={withBase("/blog/")} class="font-mono text-xs text-neutral-600 hover:text-cyan-400">all →</a>
    </div>
    <ul class="space-y-2">
      {latestBlogs.map((entry) => (
        <li class="group rounded-lg border border-neutral-900 bg-neutral-950 px-4 py-3 hover:border-neutral-800">
          <a href={withBase(`/blog/${entry.id}/`)} class="text-sm font-medium text-neutral-300 group-hover:text-cyan-300">
            {entry.data.title}
          </a>
          <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[10px] tracking-wide text-neutral-600">
            <span>{entry.data.date.toLocaleDateString("en-CA")}</span>
            <span class="text-neutral-800">·</span>
            <span>{estimateReadingTime(entry.body || entry.data.description || "")} min read</span>
            {entry.data.tags.slice(0, 2).map((tag) => (
              <>
                <span class="text-neutral-800">·</span>
                <span>{tag}</span>
              </>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
