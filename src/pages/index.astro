---
import { getPublishedBlogPosts, getPublishedCtfPosts, isProtectedPost } from "../lib/content";
import { estimateReadingTime, formatDateCA, withBase } from "../utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteRoutes } from "../config/site-routes";

const latestCtf = (await getPublishedCtfPosts()).slice(0, 3);
const latestBlogs = (await getPublishedBlogPosts()).slice(0, 3);
const homeRoutes = siteRoutes
  .filter((route) => route.path !== "/")
  .map((route) => ({ ...route, href: withBase(route.path) }));
---

<BaseLayout title="KYRUX BLOG | Offensive Security Field Notes" description="CTF write-ups, security research, and practical field notes by Kyrux.">
  <section class="codex-hero" aria-labelledby="hero-title">
    <div class="codex-copy">
      <h1 id="hero-title" class="codex-title" translate="no">
        <span>KYRUX</span>
        <em>BLOG</em>
      </h1>

      <p class="codex-deck">
        Offensive security notes.
      </p>

      <nav class="home-route-menu" aria-label="Explore Kyrux">
        <ul>
          {homeRoutes.map((route) => (
            <li>
              <a
                href={route.href}
                class="home-route-link"
                data-route-title={route.label}
              >
                {route.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="dracula-stage" aria-hidden="true">
      <svg class="dracula-wing dracula-wing--left" viewBox="0 0 520 420" preserveAspectRatio="none" aria-hidden="true">
        <path d="M515 166C420 74 278 27 18 48c88 62 122 142 117 262q30-70 60 25q38-80 76 15q48-90 96-16q86-67 148-24V166Z" />
      </svg>
      <svg class="dracula-wing dracula-wing--right" viewBox="0 0 520 420" preserveAspectRatio="none" aria-hidden="true">
        <path d="M515 166C420 74 278 27 18 48c88 62 122 142 117 262q30-70 60 25q38-80 76 15q48-90 96-16q86-67 148-24V166Z" />
      </svg>

      <div class="dracula-doorway" aria-hidden="true">
        <div class="dracula-door-frame">
          <div class="dracula-door-glow"><strong>K</strong></div>
          <div class="dracula-door dracula-door--left"><i></i></div>
          <div class="dracula-door dracula-door--right"><i></i></div>
          <span class="dracula-door-seal">K</span>
        </div>
      </div>
    </div>
  </section>

  <div class="home-feed">
    <section class="feed-section reveal" aria-labelledby="latest-ctf">
      <div class="feed-intro">
        <h2 id="latest-ctf">Latest<br /><span>CTF</span></h2>
        <p>Reproducible exploit chains, stripped down to the decisions that mattered.</p>
        <a href={withBase("/ctf/")} class="feed-all">View complete archive →</a>
      </div>

      <ol class="dossier-list">
        {latestCtf.map((entry, index) => (
          <li class="dossier-card">
            <a href={withBase(`/ctf/${entry.id}/`)}>
              <div class="dossier-index">{String(index + 1).padStart(2, "0")}</div>
              <div class="dossier-body">
                <div class="dossier-meta">
                  <span>{entry.data.platform}</span>
                  {entry.data.difficulty && <span class={`chip chip--${entry.data.difficulty.toLowerCase()}`}>{entry.data.difficulty}</span>}
                  {isProtectedPost(entry) && <span class="chip chip--hard">Private</span>}
                  <time datetime={entry.data.date.toISOString()}>{formatDateCA(entry.data.date)}</time>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.vulnerability_type ?? entry.data.category ?? "Security research"}</p>
              </div>
              <span class="dossier-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="feed-section feed-section--notes reveal" aria-labelledby="latest-notes">
      <div class="feed-intro">
        <h2 id="latest-notes">Research<br /><span>Notes</span></h2>
        <p>Concepts, experiments, and technical references made useful in the field.</p>
        <a href={withBase("/blog/")} class="feed-all">Open the notebook →</a>
      </div>

      <ol class="dossier-list">
        {latestBlogs.map((entry, index) => (
          <li class="dossier-card">
            <a href={withBase(`/blog/${entry.id}/`)}>
              <div class="dossier-index">{String(index + 1).padStart(2, "0")}</div>
              <div class="dossier-body">
                <div class="dossier-meta">
                  <time datetime={entry.data.date.toISOString()}>{formatDateCA(entry.data.date)}</time>
                  <span>{estimateReadingTime(entry.body || entry.data.description || "")} min read</span>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description ?? entry.data.tags.slice(0, 3).join(" / ")}</p>
              </div>
              <span class="dossier-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
