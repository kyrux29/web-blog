---
import { getPublishedBlogPosts } from "../../lib/content";
import { withBase } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const blogEntries = await getPublishedBlogPosts();

// Group by series
const groupedBySeries = blogEntries.reduce((acc, entry) => {
  const seriesName = entry.data.series || "Uncategorized";
  if (!acc[seriesName]) {
    acc[seriesName] = {
      title: seriesName,
      order: entry.data.seriesOrder ?? 999,
      posts: []
    };
  }
  acc[seriesName].posts.push(entry);
  return acc;
}, {} as Record<string, { title: string; order: number; posts: any[] }>);

const seriesGroups = Object.values(groupedBySeries).sort((a, b) => a.order - b.order);

// Sort posts inside each series alphabetically by ID or title
seriesGroups.forEach(group => {
  group.posts.sort((a, b) => a.id.localeCompare(b.id));
});
---

<BaseLayout title="Kyrux Blog | Security Notes">
  <section class="inner-page-hero mb-8 pt-4">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100">Kyrux Blog</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Security notes, learning paths, and field references.
    </p>
  </section>

  <div class="archive-grid grid grid-cols-1 md:grid-cols-2 gap-6 pb-12">
    {
      seriesGroups.map((group) => (
        <div class="archive-series group">
          <div class="archive-series-head">
            <h2 class="archive-series-title">
              {group.title}
            </h2>
            <span class="archive-series-count">
              {group.posts.length} {group.posts.length === 1 ? 'chapter' : 'chapters'}
            </span>
          </div>
          
          <ul class="archive-chapters">
            {group.posts.map((post, index) => (
              <li>
                <a 
                  href={withBase(`/blog/${post.id}/`)} 
                  class="archive-chapter group/link"
                >
                  <span class="archive-chapter-index">
                    {(index + 1).toString().padStart(2, '0')}
                  </span>
                  <span class="archive-chapter-title">
                    {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</BaseLayout>
