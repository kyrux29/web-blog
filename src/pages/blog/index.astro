---
import { getPublishedBlogPosts } from "../../lib/content";
import { withBase } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const blogEntries = await getPublishedBlogPosts();

// Group by series
const groupedBySeries = blogEntries.reduce((acc, entry) => {
  const seriesName = entry.data.series || "Uncategorized";
  if (!acc[seriesName]) {
    acc[seriesName] = {
      title: seriesName,
      order: entry.data.seriesOrder ?? 999,
      posts: []
    };
  }
  acc[seriesName].posts.push(entry);
  return acc;
}, {} as Record<string, { title: string; order: number; posts: any[] }>);

const seriesGroups = Object.values(groupedBySeries).sort((a, b) => a.order - b.order);

// Sort posts inside each series alphabetically by ID or title
seriesGroups.forEach(group => {
  group.posts.sort((a, b) => a.id.localeCompare(b.id));
});
---

<BaseLayout title="Documentation Library | Kyrux">
  <section class="mb-8 pt-4">
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100">Documentation Library</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Structured learning paths and comprehensive notes on web security, system administration, and exploitation techniques.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-12">
    {
      seriesGroups.map((group) => (
        <div class="glass-panel group card-lift p-6 flex flex-col relative overflow-hidden bg-white/[0.02] border-white/[0.05]">
          <div class="mb-4 flex items-center justify-between border-b border-white/[0.08] pb-3">
            <h2 class="font-sans text-xl font-bold text-cyan-100 tracking-tight group-hover:text-cyan-300 transition-colors">
              {group.title}
            </h2>
            <span class="font-mono text-xs text-neutral-500 bg-white/[0.03] px-2 py-1 rounded-sm border border-white/[0.05]">
              {group.posts.length} {group.posts.length === 1 ? 'chapter' : 'chapters'}
            </span>
          </div>
          
          <ul class="space-y-1.5 flex-1 mt-2">
            {group.posts.map((post, index) => (
              <li>
                <a 
                  href={withBase(`/blog/${post.id}/`)} 
                  class="group/link flex items-baseline gap-3 rounded-md px-2 py-1.5 hover:bg-white/[0.03] transition-colors"
                >
                  <span class="font-mono text-xs text-neutral-600 group-hover/link:text-cyan-500 transition-colors">
                    {(index + 1).toString().padStart(2, '0')}
                  </span>
                  <span class="text-sm font-medium text-neutral-300 group-hover/link:text-cyan-300 transition-colors">
                    {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</BaseLayout>
