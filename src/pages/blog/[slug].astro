---
import { getPublishedBlogPosts } from "../../lib/content";
import { withBase } from "../../utils";
import PostLayout from "../../layouts/PostLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getPublishedBlogPosts();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const isProtected = Boolean(entry.data.password || entry.data.password_env);

const siteUrl = Astro.site ?? new URL("https://kyrux29.github.io");
const canonicalUrl = new URL(withBase(`/blog/${entry.id}/`), siteUrl).toString();

const allEntries = await getPublishedBlogPosts();
const related = allEntries
  .filter((item) => item.id !== entry.id)
  .map((item) => {
    const overlap = item.data.tags.filter((tag) => entry.data.tags.includes(tag)).length;
    return { item, overlap };
  })
  .filter(({ overlap }) => overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.item.data.date.valueOf() - a.item.data.date.valueOf())
  .slice(0, 3)
  .map(({ item }) => item);
---

<PostLayout
  title={entry.data.title}
  date={entry.data.date}
  description={entry.data.description}
  tags={entry.data.tags}
  headings={headings}
  protected={isProtected}
  canonicalUrl={canonicalUrl}
>
  <Content />
  {related.length > 0 && (
    <section class="panel mt-10 p-5">
      <h2 class="mb-4 text-xl font-semibold text-neutral-100">Related Research</h2>
      <ul class="space-y-3">
        {related.map((item) => (
          <li>
            <a href={withBase(`/blog/${item.id}/`)} class="text-neutral-200 hover:text-cyan-300">
              {item.data.title}
            </a>
            <p class="mt-1 text-sm text-neutral-400">{item.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</PostLayout>
