---
import BaseLayout from "../../layouts/BaseLayout.astro";

const vulnClasses = [
  { name: "SSRF", level: 92, desc: "Server-Side Request Forgery chains — cloud metadata, internal pivoting", color: "bg-rose-500" },
  { name: "SQL Injection", level: 88, desc: "Error-based, UNION, blind, out-of-band exfiltration", color: "bg-amber-500" },
  { name: "Prototype Pollution", level: 85, desc: "Client & server-side PP, gadget chain discovery", color: "bg-violet-500" },
  { name: "Insecure Deserialization", level: 78, desc: "PHP, Python pickle, Java ysoserial gadget chains", color: "bg-cyan-500" },
  { name: "Auth Bypass", level: 80, desc: "JWT manipulation, OAuth misconfig, race conditions", color: "bg-emerald-500" },
  { name: "XSS / CSTI", level: 75, desc: "Stored, DOM, mutation, Angular/React template injection", color: "bg-orange-500" },
];

const tools = [
  { name: "Burp Suite", desc: "Web proxy & intercept", icon: ">>", cat: "primary" },
  { name: "Caido", desc: "Modern web auditing", icon: ">>", cat: "primary" },
  { name: "sqlmap", desc: "SQLi automation", icon: ">>", cat: "primary" },
  { name: "ffuf", desc: "Web fuzzing engine", icon: ">>", cat: "primary" },
  { name: "nuclei", desc: "Template-based scanning", icon: ">>", cat: "primary" },
  { name: "Python", desc: "Exploit scripting", icon: ">>", cat: "lang" },
  { name: "Docker", desc: "Lab environments", icon: ">>", cat: "support" },
  { name: "Neovim", desc: "Code editor", icon: ">>", cat: "support" },
  { name: "ParrotOS", desc: "Daily driver", icon: ">>", cat: "support" },
];

const links = [
  { label: "GitHub", href: "https://github.com/kyrux29", desc: "Exploit PoCs, tooling, CTF scripts" },
  { label: "HackTheBox", href: "https://app.hackthebox.com/users/kyrux29", desc: "Rank: Hacker · Pro Labs" },
  { label: "CTFtime", href: "https://ctftime.org/user/kyrux29", desc: "Solo player · Web specialist" },
];
---

<BaseLayout title="About | Kyrux">
  <div class="mx-auto max-w-3xl space-y-12">
    <!-- ====== Header ====== -->
    <section>
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <div class="relative flex-shrink-0">
          <div class="flex h-24 w-24 items-center justify-center rounded-xl border-2 border-cyan-500/30 bg-neutral-900 ring-1 ring-cyan-500/10">
            <span class="font-mono text-4xl font-bold text-cyan-400 glitch" data-text="K">K</span>
          </div>
          <span class="absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 ring-2 ring-neutral-950">
            <span class="block h-2 w-2 rounded-full bg-neutral-950"></span>
          </span>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-[10px] tracking-[0.3em] text-neutral-600 uppercase">Vu Trong Quoc Khanh</p>
          <h1 class="font-mono text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">Kyrux</h1>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-mono text-cyan-400">~$ whoami</span>
            <span class="font-mono text-neutral-500">→</span>
            <span class="font-mono text-neutral-300">cybersecurity researcher</span>
          </div>
          <p class="mt-3 max-w-xl font-mono text-sm leading-relaxed text-neutral-400">
            <span class="text-rose-400">flag{</span>web_app_exploitation<span class="text-rose-400">}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ====== ASCII Divider ====== -->
    <div class="ascii-divider" aria-hidden="true">
      ───────────────────────────────────────────────
    </div>

    <!-- ====== Philosophy ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Philosophy
      </h2>
      <div class="panel p-5 space-y-4">
        <p class="font-mono text-sm leading-relaxed text-neutral-300">
          <span class="text-cyan-400">></span> I treat every CTF challenge as a learning opportunity — dissecting source code,
          bypassing filters, and chaining vulnerabilities into working exploits. This blog is my
          <span class="text-cyan-400">digital lab notebook</span>: raw, technical, and reproducible.
        </p>
        <p class="font-mono text-sm leading-relaxed text-neutral-400">
          <span class="text-neutral-600">></span> When I'm not hunting flags, I'm building offensive tooling, studying protocol internals
          (HTTP/2, gRPC, WebSockets), or reverse-engineering web frameworks for zero-day research.
        </p>
        <div class="border-t border-neutral-800 pt-3">
          <pre class="font-mono text-[10px] leading-relaxed text-neutral-500 overflow-x-auto">
<span class="text-neutral-600">/* mindset.ts */</span>
<span class="text-rose-400">export const</span> <span class="text-neutral-300">mindset</span> = <span class="text-emerald-400">"Think like an attacker, document like a scientist"</span>;
<span class="text-neutral-600">// compile with: curiosity + persistence</span></pre>
        </div>
      </div>
    </section>

    <!-- ====== Toolbox ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Toolbox <span class="text-neutral-700">($ ls /opt/)</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <div class="flex items-center gap-3 rounded-lg border border-neutral-800 bg-neutral-900/80 px-3.5 py-2.5 hover:border-cyan-500/30 hover:bg-neutral-900 transition-colors group cursor-default">
            <span class="flex-shrink-0 font-mono text-[10px] text-cyan-500 group-hover:text-cyan-300 transition-colors">{tool.icon}</span>
            <div class="min-w-0">
              <p class="font-mono text-[11px] text-neutral-200 group-hover:text-cyan-300 transition-colors">{tool.name}</p>
              <p class="font-mono text-[9px] text-neutral-600">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ====== Presence ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Presence <span class="text-neutral-700">($ dig kyrux -t ANY)</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="panel group flex flex-col gap-1 px-4 py-3 hover:border-cyan-500/40 transition-colors"
          >
            <span class="font-mono text-sm text-neutral-200 group-hover:text-cyan-300 transition-colors">
              <span class="text-cyan-400">▸ </span>{link.label}
            </span>
            <span class="font-mono text-[9px] leading-relaxed text-neutral-600">{link.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ====== Status ====== -->
    <section class="reveal">
      <div class="panel border-emerald-500/20 bg-emerald-950/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <div>
            <p class="font-mono text-sm text-emerald-300">$ systemctl status kyrux.service</p>
            <p class="font-mono text-[10px] text-emerald-600">Active: running · Accepting security collaborations & CTF team-ups</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== Footer ====== -->
    <div class="ascii-divider" aria-hidden="true">───────────────────────────────────────────────</div>
    <p class="text-center font-mono text-[10px] text-neutral-700"></> with ☕ by kyrux · Est. 2024</p>
  </div>
</BaseLayout>
