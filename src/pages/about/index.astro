---
import BaseLayout from "../../layouts/BaseLayout.astro";

const skills = [
  { name: "Web Exploitation", level: 90, cat: "offensive" },
  { name: "Python", level: 85, cat: "lang" },
  { name: "JavaScript / Node.js", level: 80, cat: "lang" },
  { name: "SQL Injection", level: 88, cat: "offensive" },
  { name: "Burp Suite", level: 85, cat: "tool" },
  { name: "Docker", level: 75, cat: "devops" },
  { name: "Linux Admin", level: 82, cat: "sys" },
  { name: "Reverse Engineering", level: 60, cat: "offensive" },
  { name: "Go / Rust", level: 55, cat: "lang" },
  { name: "Network Pentesting", level: 70, cat: "offensive" },
  { name: "CI/CD Security", level: 65, cat: "devops" },
  { name: "Cryptography", level: 50, cat: "offensive" },
];

const certifications = [
  { name: "HTB Certified Penetration Testing Specialist", org: "Hack The Box", year: 2025, status: "in-progress" },
  { name: "PortSwigger Web Security Academy", org: "PortSwigger", year: 2024, status: "completed" },
  { name: "TryHackMe Top 1%", org: "TryHackMe", year: 2024, status: "completed" },
];

const timeline = [
  { year: "2026", title: "Published 10+ CTF write-ups", desc: "Documented advanced web exploitation techniques on kyrux blog. Covered SSRF chains, prototype pollution, and deserialization attacks." },
  { year: "2025", title: "Began HTB CPTS Certification", desc: "Started professional penetration testing certification through Hack The Box Academy." },
  { year: "2024", title: "Started Cybersecurity Blog", desc: "Launched kyrux.github.io to document CTF solutions and security research. Built with Astro and custom terminal UI." },
  { year: "2023", title: "First CTF Competition", desc: "Participated in first Capture The Flag competition. Discovered passion for web exploitation and offensive security." },
  { year: "2022", title: "Started Programming", desc: "Began learning Python and web development. Built first full-stack applications with Flask and React." },
];

const tools = [
  { name: "ParrotOS", desc: "Daily driver OS", icon: "🦜", cat: "os" },
  { name: "Neovim", desc: "Code editor", icon: "", cat: "editor" },
  { name: "Obsidian", desc: "Knowledge base", icon: "📓", cat: "notes" },
  { name: "Burp Suite", desc: "Web proxy & intercept", icon: "🔍", cat: "security" },
  { name: "Docker", desc: "Lab environments", icon: "🐳", cat: "devops" },
  { name: "Git", desc: "Version control", icon: "⎇", cat: "devops" },
  { name: "Wireshark", desc: "Network analysis", icon: "🦈", cat: "security" },
  { name: "Ghidra", desc: "Reverse engineering", icon: "🐉", cat: "re" },
  { name: "Metasploit", desc: "Exploitation framework", icon: "💀", cat: "security" },
  { name: "nmap", desc: "Network discovery", icon: "🎯", cat: "security" },
  { name: "sqlmap", desc: "SQLi automation", icon: "💉", cat: "security" },
  { name: "ffuf", desc: "Web fuzzing", icon: "⚡", cat: "security" },
];

const links = [
  { label: "GitHub", href: "https://github.com/kyrux29", icon: "▸", desc: "Open source projects & CTF scripts" },
  { label: "HackTheBox", href: "https://app.hackthebox.com/users/kyrux29", icon: "▸", desc: "Rank: Hacker | Pro Labs" },
  { label: "CTFtime", href: "https://ctftime.org/user/kyrux29", icon: "▸", desc: "Team: Solo / Freelance" },
];

const catLabels: Record<string, string> = {
  offensive: "Offensive",
  lang: "Language",
  tool: "Tool",
  devops: "DevOps",
  sys: "System",
};

const catColors: Record<string, string> = {
  offensive: "bg-rose-500",
  lang: "bg-cyan-500",
  tool: "bg-amber-500",
  devops: "bg-emerald-500",
  sys: "bg-violet-500",
};

const statusColors: Record<string, string> = {
  "completed": "text-emerald-400 border-emerald-500/30 bg-emerald-950/20",
  "in-progress": "text-amber-400 border-amber-500/30 bg-amber-950/20",
};
---

<BaseLayout title="About | Kyrux">
  <div class="mx-auto max-w-3xl space-y-12">
    <!-- ====== Header with avatar ====== -->
    <section>
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <!-- Avatar -->
        <div class="relative flex-shrink-0">
          <div class="flex h-24 w-24 items-center justify-center rounded-xl border-2 border-cyan-500/30 bg-neutral-900 ring-1 ring-cyan-500/10">
            <span class="font-mono text-4xl font-bold text-cyan-400 glitch" data-text="K">K</span>
          </div>
          <span class="absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 ring-2 ring-neutral-950">
            <span class="block h-2 w-2 rounded-full bg-neutral-950"></span>
          </span>
        </div>

        <div class="min-w-0">
          <p class="font-mono text-[10px] tracking-[0.3em] text-neutral-600 uppercase">Vu Trong Quoc Khanh</p>
          <h1 class="text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
            Kyrux
          </h1>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-mono text-cyan-400">~$ whoami</span>
            <span class="text-neutral-500">→</span>
            <span class="font-mono text-neutral-300">cybersecurity researcher</span>
          </div>
          <p class="mt-3 max-w-xl font-mono text-sm leading-relaxed text-neutral-400">
            Web exploitation specialist. I dissect applications, chain vulnerabilities, and document every step.
          </p>
        </div>
      </div>
    </section>

    <!-- ====== ASCII Divider ====== -->
    <div class="ascii-divider" aria-hidden="true">
      ───────────────────────────────────────────────
    </div>

    <!-- ====== Bio ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Philosophy
      </h2>
      <div class="panel p-5 space-y-4">
        <p class="font-mono text-sm leading-relaxed text-neutral-300">
          <span class="text-cyan-400">></span> I treat every CTF challenge as a learning opportunity — dissecting source code,
          bypassing filters, and chaining vulnerabilities into working exploits. This blog is my
          <span class="text-cyan-400">digital lab notebook</span>: raw, technical, and reproducible.
        </p>
        <p class="font-mono text-sm leading-relaxed text-neutral-400">
          <span class="text-neutral-600">></span> When I'm not hunting flags, I'm building offensive tooling, studying protocol internals
          (HTTP/2, gRPC, WebSockets), or reverse-engineering binaries with Ghidra.
        </p>
        <div class="border-t border-neutral-800 pt-3">
          <p class="font-mono text-[11px] text-neutral-600">
            <span class="text-cyan-500">const</span> <span class="text-neutral-300">mindset</span> = <span class="text-emerald-400">"Think like an attacker, document like a scientist"</span>;
          </p>
        </div>
      </div>
    </section>

    <!-- ====== Skills Matrix ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Skills Matrix
      </h2>
      <div class="panel p-5">
        <div class="space-y-3">
          {skills.map((skill) => (
            <div class="flex items-center gap-3">
              <div class="w-28 flex-shrink-0 sm:w-36">
                <div class="flex items-center gap-1.5">
                  <span class={`inline-block h-1.5 w-1.5 rounded-full ${catColors[skill.cat] ?? 'bg-neutral-500'}`}></span>
                  <span class="font-mono text-[11px] text-neutral-300 truncate">{skill.name}</span>
                </div>
              </div>
              <div class="flex-1 h-2 rounded-full bg-neutral-800 overflow-hidden">
                <div
                  class={`h-full rounded-full transition-all duration-700 ease-out ${catColors[skill.cat] ?? 'bg-neutral-500'}`}
                  style={`width: ${skill.level}%`}
                ></div>
              </div>
              <span class="w-9 text-right font-mono text-[10px] text-neutral-600">{skill.level}%</span>
            </div>
          ))}
        </div>
        <!-- Legend -->
        <div class="mt-4 flex flex-wrap gap-3 border-t border-neutral-800 pt-3">
          {Object.entries(catLabels).map(([key, label]) => (
            <div class="flex items-center gap-1.5">
              <span class={`inline-block h-2 w-2 rounded-full ${catColors[key] ?? ''}`}></span>
              <span class="font-mono text-[10px] text-neutral-500">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== Certifications ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Certifications
      </h2>
      <div class="space-y-2">
        {certifications.map((cert) => (
          <div class={`panel flex items-center gap-4 px-4 py-3 ${statusColors[cert.status] ?? ''}`}>
            <div class="flex-shrink-0">
              <span class={`font-mono text-lg ${cert.status === 'completed' ? 'text-emerald-400' : 'text-amber-400'}`}>
                {cert.status === 'completed' ? '✓' : '⟳'}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-sm text-neutral-200">{cert.name}</p>
              <p class="font-mono text-[10px] text-neutral-500">{cert.org} &middot; {cert.year}</p>
            </div>
            <span class={`flex-shrink-0 font-mono text-[9px] tracking-wider uppercase px-2 py-0.5 rounded-full border ${cert.status === 'completed' ? 'border-emerald-500/30 text-emerald-400' : 'border-amber-500/30 text-amber-400'}`}>
              {cert.status === 'completed' ? 'Done' : 'Active'}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- ====== Timeline ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Timeline
      </h2>
      <div class="relative border-l-2 border-neutral-800 ml-3 space-y-6">
        {timeline.map((item) => (
          <div class="relative pl-8">
            <!-- Dot -->
            <div class="absolute left-0 top-1 -translate-x-1/2 flex items-center justify-center">
              <span class="block h-2.5 w-2.5 rounded-full border-2 border-cyan-500 bg-neutral-950 ring-2 ring-neutral-950"></span>
            </div>
            <div class="panel p-4">
              <div class="flex items-baseline gap-2 mb-1">
                <span class="font-mono text-xs text-cyan-400 font-semibold">{item.year}</span>
                <span class="font-mono text-[10px] text-neutral-600">// {item.title}</span>
              </div>
              <p class="font-mono text-[11px] leading-relaxed text-neutral-400">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ====== Tools Grid ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Toolbox <span class="text-neutral-700">($ ls /opt/)</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <div class="flex items-center gap-3 rounded-lg border border-neutral-800 bg-neutral-900/80 px-3.5 py-2.5 hover:border-cyan-500/30 hover:bg-neutral-900 transition-colors group cursor-default">
            <span class="flex-shrink-0 font-mono text-base" aria-hidden="true">{tool.icon}</span>
            <div class="min-w-0">
              <p class="font-mono text-[11px] text-neutral-200 group-hover:text-cyan-300 transition-colors">{tool.name}</p>
              <p class="text-[9px] tracking-wide text-neutral-600">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ====== Links ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> Presence <span class="text-neutral-700">($ dig kyrux -t ANY)</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="panel group flex flex-col gap-1 px-4 py-3 hover:border-cyan-500/40 transition-colors"
          >
            <span class="font-mono text-sm text-neutral-200 group-hover:text-cyan-300 transition-colors">
              <span class="text-cyan-400">{link.icon}</span> {link.label}
            </span>
            <span class="font-mono text-[9px] text-neutral-600 leading-relaxed">{link.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ====== Status ====== -->
    <section class="reveal">
      <div class="panel border-emerald-500/20 bg-emerald-950/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <div>
            <p class="font-mono text-sm text-emerald-300">System Online</p>
            <p class="font-mono text-[10px] text-emerald-600">Accepting security collaborations & CTF team-ups</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== PGP Public Key ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-xs tracking-[0.2em] text-neutral-500 uppercase">
        <span class="text-cyan-400">#</span> PGP Key <span class="text-neutral-700">($ gpg --export kyrux)</span>
      </h2>
      <div class="panel p-4" id="pgp-key-block">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2 min-w-0">
            <span class="font-mono text-[9px] text-cyan-400 tracking-wider flex-shrink-0">FINGERPRINT</span>
            <code class="font-mono text-[10px] text-neutral-300 truncate">ABCD EFGH IJKL MNOP QRST UVWX YZ12 3456 7890 ABC</code>
          </div>
          <a href="/pgp-key.asc" download class="flex-shrink-0 font-mono text-[10px] text-neutral-400 hover:text-cyan-300 transition-colors underline underline-offset-2">
            ⬇ key.asc
          </a>
        </div>
        <pre class="font-mono text-[10px] leading-relaxed text-neutral-500 overflow-x-auto max-h-44 bg-neutral-950 rounded-lg p-3 border border-neutral-800"><code>-----BEGIN PGP PUBLIC KEY BLOCK-----

mQINBGabcdefBEACw1234ABCDEFGHIJKLMNOPQRSTUVWXYZ
abcdefghijkl0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZ
abcdefghijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLM
NOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/
ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy
z0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijkl
mnopqrstuvwxyz0123456789+/ABCDEFGHIJK==
=ABCD
-----END PGP PUBLIC KEY BLOCK-----</code></pre>
        <p class="mt-2 font-mono text-[9px] text-neutral-600">
          Key ID: <code class="text-neutral-500">0xDEADBEEF</code> &middot; Encrypt sensitive communications
        </p>
      </div>
    </section>

    <!-- ====== Footer ASCII art ====== -->
    <div class="ascii-divider" aria-hidden="true">
      ───────────────────────────────────────────────
    </div>
    <p class="text-center font-mono text-[10px] text-neutral-700">
      </> with ☕ by kyrux &middot; Est. 2024
    </p>
  </div>
</BaseLayout>
