---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  { name: "ParrotOS", desc: "Daily driver OS" },
  { name: "Neovim", desc: "Code editor" },
  { name: "Obsidian", desc: "Knowledge base" },
  { name: "Burp Suite", desc: "Web proxy" },
  { name: "Docker", desc: "Lab environments" },
  { name: "Git", desc: "Version control" },
];

const links = [
  { label: "GitHub", href: "https://github.com/kyrux29", icon: "▸" },
  { label: "HackTheBox", href: "https://app.hackthebox.com/users/kyrux29", icon: "▸" },
  { label: "CTFtime", href: "https://ctftime.org/user/kyrux29", icon: "▸" },
];

---

<BaseLayout title="About | Kyrux">
  <div class="mx-auto max-w-3xl space-y-10">
    <!-- Header with avatar -->
    <section>
      <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <!-- Avatar: SVG-generated identicon-style placeholder -->
        <div class="flex h-20 w-20 flex-none items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900">
          <span class="font-mono text-3xl text-cyan-400">K</span>
        </div>
        <div>
          <p class="font-mono text-[10px] tracking-[0.25em] text-neutral-600">Vu Trong Quoc Khanh</p>
          <h1 class="text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">
            Kyrux
          </h1>
          <p class="mt-2 max-w-xl font-mono text-sm leading-relaxed text-neutral-400">
            Cybersecurity student. Web exploitation enthusiast. I break web apps and write about it.
          </p>
        </div>
      </div>
    </section>

    <!-- Bio -->
    <section class="reveal">
      <div class="border-l-2 border-cyan-500/30 pl-4">
        <p class="font-mono text-sm leading-relaxed text-neutral-300">
          I treat every CTF challenge as a learning opportunity — dissecting source code, bypassing filters,
          and chaining vulnerabilities into working exploits. This blog is my digital lab notebook:
          <span class="text-cyan-400"> raw, technical, and reproducible.</span>
        </p>
        <p class="mt-3 font-mono text-sm leading-relaxed text-neutral-400">
          When I'm not hunting flags, I'm building offensive tooling, studying compiler internals,
          or diving deep into web protocol internals (HTTP/2, gRPC, WebSockets).
        </p>
      </div>
    </section>

    <!-- Tools -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-sm text-neutral-400">
        <span class="text-cyan-400">$</span> ls /opt/toolbox/
      </h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {tools.map((tool) => (
          <div class="flex items-center gap-3 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2.5">
            <span class="font-mono text-xs text-cyan-400">▸</span>
            <div>
              <p class="font-mono text-sm text-neutral-200">{tool.name}</p>
              <p class="text-[10px] tracking-wide text-neutral-600">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Links -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-sm text-neutral-400">
        <span class="text-cyan-400">$</span> dig kyrux -t links
      </h2>
      <div class="flex flex-wrap gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2.5 font-mono text-sm text-neutral-300 hover:border-cyan-500/40 hover:text-cyan-300 transition-colors"
          >
            <span class="text-cyan-400">{link.icon}</span>
            {link.label}
          </a>
        ))}
      </div>
    </section>

    <!-- Status -->
    <section class="reveal">
      <div class="rounded-lg border border-emerald-500/20 bg-emerald-950/20 px-4 py-3">
        <p class="font-mono text-xs text-emerald-300">
          <span class="text-emerald-400">●</span> Status: Open for security collaborations & CTF team-ups
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
