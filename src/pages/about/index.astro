---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  { name: "Burp Suite", desc: "Web proxy & intercept" },
  { name: "Caido", desc: "Modern web auditing" },
  { name: "sqlmap", desc: "SQLi automation" },
  { name: "ffuf", desc: "Web fuzzing engine" },
  { name: "nuclei", desc: "Template-based scanning" },
  { name: "Python", desc: "Exploit scripting" },
  { name: "Docker", desc: "Lab environments" },
  { name: "Neovim", desc: "Code editor" },
  { name: "ParrotOS", desc: "Daily driver" },
];

const links = [
  { label: "GitHub", href: "https://github.com/kyrux29", desc: "Exploit PoCs, tooling, CTF scripts" },
  { label: "HackTheBox", href: "https://app.hackthebox.com/users/kyrux29", desc: "Rank: Hacker · Pro Labs" },
  { label: "CTFtime", href: "https://ctftime.org/user/kyrux29", desc: "Solo player · Web specialist" },
];
---

<BaseLayout title="About | Kyrux">
  <div class="mx-auto max-w-3xl space-y-10 pt-4">
    <!-- ====== Header ====== -->
    <section class="glass-panel p-6 sm:p-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <div class="relative flex-shrink-0">
          <div class="flex h-20 w-20 items-center justify-center rounded-sm border-2 border-cyan-500/20 bg-white/[0.03] backdrop-blur-xl">
            <span class="font-mono text-3xl font-bold text-cyan-400">K</span>
          </div>
          <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-sm bg-emerald-500 ring-2 ring-neutral-950">
            <span class="block h-1.5 w-1.5 rounded-sm bg-neutral-950"></span>
          </span>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-[10px] tracking-[0.3em] text-neutral-500 uppercase">Vu Trong Quoc Khanh</p>
          <h1 class="hero-title text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl">Kyrux</h1>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-mono text-cyan-400">~$ whoami</span>
            <span class="text-neutral-600">→</span>
            <span class="text-neutral-300">cybersecurity researcher</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== Philosophy ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Philosophy
      </h2>
      <div class="glass-panel p-5 sm:p-6 space-y-4">
        <p class="text-sm leading-relaxed text-neutral-300">
          <span class="text-cyan-400 font-mono">></span> I treat every CTF challenge as a learning opportunity — dissecting source code,
          bypassing filters, and chaining vulnerabilities into working exploits. This blog is my
          <span class="text-cyan-400">digital lab notebook</span>: raw, technical, and reproducible.
        </p>
        <p class="text-sm leading-relaxed text-neutral-400">
          <span class="text-neutral-600 font-mono">></span> When I'm not hunting flags, I'm building offensive tooling, studying protocol internals
          (HTTP/2, gRPC, WebSockets), or reverse-engineering web frameworks for zero-day research.
        </p>
        <div class="border-t-2 border-white/[0.06] pt-4">
          <pre class="font-mono text-[10px] leading-relaxed text-neutral-500 overflow-x-auto">
<span class="text-neutral-600">/* mindset.ts */</span>
<span class="text-rose-400">export const</span> <span class="text-neutral-300">mindset</span> = <span class="text-emerald-400">"Think like an attacker, document like a scientist"</span>;
<span class="text-neutral-600">// compile with: curiosity + persistence</span></pre>
        </div>
      </div>
    </section>

    <!-- ====== Toolbox ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Toolbox
      </h2>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <div class="glass-panel card-lift flex items-center gap-3 px-4 py-3 group cursor-default">
            <span class="flex-shrink-0 font-mono text-[10px] text-cyan-500/60 group-hover:text-cyan-400 transition-colors duration-100">▸</span>
            <div class="min-w-0">
              <p class="font-mono text-[11px] text-neutral-200 group-hover:text-cyan-300 transition-colors duration-100">{tool.name}</p>
              <p class="text-[9px] text-neutral-500">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ====== Presence ====== -->
    <section class="reveal">
      <h2 class="mb-4 font-mono text-[10px] tracking-[0.25em] text-neutral-500 uppercase">
        <span class="text-cyan-400"># </span>Presence
      </h2>
      <div class="grid gap-2 sm:grid-cols-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="glass-panel card-lift group flex flex-col gap-1.5 px-4 py-3"
          >
            <span class="font-mono text-sm text-neutral-200 group-hover:text-cyan-300 transition-colors duration-100">
              <span class="text-cyan-400">▸ </span>{link.label}
            </span>
            <span class="text-[10px] leading-relaxed text-neutral-500">{link.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ====== Status ====== -->
    <section class="reveal">
      <div class="glass-panel border-emerald-500/10 px-5 py-4">
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-sm bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-sm h-3 w-3 bg-emerald-500"></span>
          </span>
          <div>
            <p class="font-mono text-sm text-emerald-300">$ systemctl status kyrux.service</p>
            <p class="font-mono text-[10px] text-emerald-500/80">Active: running · Accepting security collaborations & CTF team-ups</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
