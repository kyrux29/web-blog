---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Search | Kyrux">
  <section class="reveal mb-6">
    <h1 class="text-4xl font-semibold tracking-tight text-neutral-100">Search</h1>
    <p class="mt-3 max-w-3xl text-neutral-400">
      Full-text search across write-ups and research notes (runs locally in your browser).
    </p>
  </section>

  <div class="reveal panel p-5">
    <input
      id="search-input"
      type="search"
      placeholder="Try: graphql batching, xss, ssrf, race condition..."
      class="w-full rounded-xl border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus:border-cyan-500 focus:outline-none"
    />
    <p id="search-hint" class="mt-3 text-xs text-neutral-500" style="font-family: var(--font-mono);">
      Index loads on first query. Tip: use multiple keywords.
    </p>
  </div>

  <div class="mt-6 panel p-5">
    <div class="mb-3 flex items-center justify-between gap-3">
      <p class="text-xs tracking-wider text-neutral-300" style="font-family: var(--font-mono);">Results</p>
      <p id="search-meta" class="text-xs text-neutral-500" style="font-family: var(--font-mono);"></p>
    </div>
    <ul id="search-results" class="space-y-3"></ul>
  </div>

  <script is:inline>
    const input = document.getElementById("search-input");
    const list = document.getElementById("search-results");
    const meta = document.getElementById("search-meta");

    const loadPagefind = async () => {
      // pagefind assets are generated into /pagefind/* after build
      const base = document.documentElement.baseURI;
      const u = new URL(base);
      const basePath = u.pathname.replace(/\/search\/?$/, "/");
      const scriptUrl = `${basePath}pagefind/pagefind.js`;
      await import(scriptUrl);
      // @ts-ignore
      await window.pagefind?.init?.();
      // @ts-ignore
      return window.pagefind;
    };

    let pagefindPromise = null;

    const render = (items) => {
      if (!list) return;
      list.innerHTML = "";
      items.forEach((item) => {
        const li = document.createElement("li");
        li.className = "rounded-xl border border-neutral-800 bg-neutral-900 p-4";
        const a = document.createElement("a");
        a.href = item.url;
        a.className = "text-lg font-medium text-neutral-100 hover:text-cyan-300";
        a.textContent = item.title || item.url;
        const p = document.createElement("p");
        p.className = "mt-2 text-sm text-neutral-400";
        p.textContent = item.excerpt || "";
        li.appendChild(a);
        li.appendChild(p);
        list.appendChild(li);
      });
    };

    const run = async () => {
      const q = (input?.value ?? "").trim();
      if (!q) {
        render([]);
        if (meta) meta.textContent = "";
        return;
      }

      if (!pagefindPromise) pagefindPromise = loadPagefind();
      const pf = await pagefindPromise;
      const res = await pf.search(q);
      const data = await Promise.all(res.results.slice(0, 12).map((r) => r.data()));
      render(data.map((d) => ({ title: d.meta?.title, url: d.url, excerpt: d.excerpt })));
      if (meta) meta.textContent = `${res.results.length} hits`;
    };

    input?.addEventListener("input", () => {
      // debounce a little
      window.clearTimeout(window.__kyruxSearchTimer);
      window.__kyruxSearchTimer = window.setTimeout(run, 120);
    });
  </script>
</BaseLayout>

