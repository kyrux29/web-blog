---
import { getPublishedCtfPosts } from "../../../lib/content";
import { withBase } from "../../../utils";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getPublishedCtfPosts();
  const platforms = Array.from(
    new Set(
      entries
        .map((entry) => entry.data.series ? entry.data.series.toLowerCase().replace(/[^a-z0-9]+/g, "-") : entry.data.platform?.toLowerCase().replace(/[^a-z0-9]+/g, "-"))
        .filter(Boolean)
    )
  );

  return platforms.map((platform) => {
    const platformEntries = entries.filter((entry) => {
      const p = entry.data.series ? entry.data.series.toLowerCase().replace(/[^a-z0-9]+/g, "-") : entry.data.platform?.toLowerCase().replace(/[^a-z0-9]+/g, "-");
      return p === platform;
    });
    
    // Attempt to get a nice display name from the first matched entry
    const displayName = platformEntries[0]?.data.series || platformEntries[0]?.data.platform || platform;

    return {
      params: { platform },
      props: { entries: platformEntries, displayName },
    };
  });
}

const { platform } = Astro.params;
const { entries, displayName } = Astro.props;

const tagHref = (tag: string) => withBase(`/tags/${encodeURIComponent(tag)}/`);
---

<BaseLayout title={`${displayName} Write-ups | Kyrux`}>
  <section class="mb-8 pt-4">
    <div class="mb-2">
      <a href={withBase("/ctf/")} class="inline-flex items-center gap-1 font-mono text-sm text-neutral-500 hover:text-cyan-400 transition-colors">
        <span>←</span>
        <span>Back to all CTF Archives</span>
      </a>
    </div>
    <h1 class="text-4xl font-bold tracking-tight text-neutral-100">{displayName}</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Viewing all write-ups for this platform/series.
    </p>
  </section>

  <ul class="space-y-4">
    {
      entries.sort((a, b) => {
        return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
      }).map((entry) => (
        <li class="glass-panel group card-lift p-5">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
            <span class="chip">{entry.data.date.toLocaleDateString("en-CA")}</span>
            <span class="chip">{entry.data.platform}</span>
            {entry.data.difficulty && <span class={`chip chip--${(entry.data.difficulty ?? "").toLowerCase()}`}>{entry.data.difficulty}</span>}
            {(entry.data.password || entry.data.password_env) && <span class="chip chip--hard">Protected</span>}
          </div>
          <a href={withBase(`/ctf/${entry.id}/`)} class="text-xl font-semibold leading-tight text-neutral-100 hover:text-cyan-300 transition-colors duration-100">
            {entry.data.title}
          </a>
          <p class="mt-3 text-sm text-neutral-400 leading-relaxed">
            {entry.data.vulnerability_type ?? entry.data.category ?? "Security research"}
          </p>
          <div class="mt-4 flex items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <a class="chip hover:text-cyan-300 hover:border-cyan-500/20" href={tagHref(tag)}>
                  {tag}
                </a>
              ))}
            </div>
            <span class="text-lg text-neutral-600 transition-colors duration-100 group-hover:text-cyan-400" aria-hidden="true">→</span>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
