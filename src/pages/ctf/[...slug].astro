---
import { getPublishedCtfPosts, getRelatedPosts, isProtectedPost } from "../../lib/content";
import { withBase, difficultyChipClass } from "../../utils";
import PostLayout from "../../layouts/PostLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getPublishedCtfPosts();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const isProtected = isProtectedPost(entry);

const siteUrl = Astro.site ?? new URL("https://kyrux.xyz");
const canonicalUrl = new URL(withBase(`/ctf/${entry.id}/`), siteUrl).toString();

const related = await getRelatedPosts(entry, 4);
---

<PostLayout 
  title={entry.data.title} 
  date={entry.data.date} 
  description={entry.data.vulnerability_type || (entry.data as any).description || "CTF Write-up"} 
  tags={entry.data.tags} 
  headings={headings} 
  protected={isProtected} 
  canonicalUrl={canonicalUrl} 
  collectionType="ctf" 
  bodyText={entry.body}
  relatedPosts={related}
  series={entry.data.series}
  currentPostId={entry.id}
>
  <div class="glass-panel mb-6 flex flex-wrap items-center gap-2 px-4 py-3 font-mono text-xs">
    <span class="chip">{entry.data.platform}</span>
    {entry.data.vulnerability_type && <span class="chip">{entry.data.vulnerability_type}</span>}
    {entry.data.difficulty && <span class={`chip ${difficultyChipClass(entry.data.difficulty)}`}>{entry.data.difficulty}</span>}
  </div>
  <Content />
</PostLayout>
