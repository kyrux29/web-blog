---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("ctf", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout title={entry.data.title} date={entry.data.date} tags={entry.data.tags} headings={headings}>
  <div class="panel mb-6 flex flex-wrap items-center gap-2 px-4 py-3 text-xs">
    <span class="chip">{entry.data.platform}</span>
    {entry.data.vulnerability_type && <span class="chip">{entry.data.vulnerability_type}</span>}
    {entry.data.difficulty && <span class="chip">Difficulty: {entry.data.difficulty}</span>}
  </div>
  <Content />
</PostLayout>
