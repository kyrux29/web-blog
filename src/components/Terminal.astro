---
// Terminal.astro – interactive pseudo-filesystem modal.
// Receives content data as JSON via a <script type="application/json"> tag.
---
<div id="terminal-modal" role="dialog" aria-modal="true" aria-labelledby="terminal-title" class="fixed inset-0 z-50 hidden items-center justify-center bg-neutral-950/50 backdrop-blur-sm p-3 sm:items-end sm:justify-end sm:p-4">
  <div class="w-full max-w-2xl overflow-hidden rounded-sm border-2 border-white/[0.08] bg-neutral-950/90 backdrop-blur-2xl shadow-[8px_8px_0_0_rgba(0,0,0,0.5)] sm:max-w-2xl">
    <div class="flex items-center justify-between border-b-2 border-white/[0.06] px-4 py-2.5">
      <div class="flex items-center gap-3">
        <p id="terminal-title" class="text-xs font-bold tracking-wider text-neutral-400">kyrux@labs:~</p>
      </div>
      <button id="terminal-close" type="button" aria-label="Close terminal" class="min-h-11 min-w-11 px-2 text-xs text-neutral-500 hover:text-rose-400 hover:bg-rose-500/10 transition-colors font-mono">[ X ]</button>
    </div>
    <div class="relative">
      <!-- Matrix canvas (hidden by default) -->
      <canvas id="matrix-canvas" aria-hidden="true" class="absolute inset-0 z-0 hidden bg-black/90 pointer-events-none" width="800" height="400"></canvas>
      <div id="terminal-output" role="log" aria-live="polite" aria-relevant="additions" class="h-[60vh] max-h-[520px] overflow-y-auto bg-neutral-950/60 px-4 py-3 font-mono text-sm text-neutral-200 relative z-10"></div>
    </div>
    <form id="terminal-form" class="flex items-center gap-2 border-t border-white/[0.06] px-4 py-3">
      <span class="font-mono text-sm text-rose-300">$</span>
      <div class="relative flex-1">
        <!-- Inline autosuggestion overlay -->
        <div id="terminal-suggestion" class="pointer-events-none absolute inset-0 z-0 flex items-center font-mono text-sm" aria-hidden="true">
          <span id="terminal-typed" class="whitespace-pre text-neutral-100"></span>
          <span id="terminal-ghost" class="whitespace-pre text-neutral-700"></span>
        </div>
        <input
          id="terminal-input"
          type="text"
          name="terminal-command"
          aria-label="Terminal command"
          autocomplete="off"
          spellcheck="false"
          class="relative z-10 w-full bg-transparent font-mono text-sm text-transparent caret-neutral-100 placeholder:text-neutral-500"
          placeholder="Type help…"
        />
      </div>
    </form>
  </div>
</div>

<script>
  interface TerminalItem {
    slug: string;
    title: string;
    summary: string;
    url: string;
  }

  interface TerminalData {
    blog: TerminalItem[];
    ctf: TerminalItem[];
  }

  interface TerminalStats {
    ctf: number;
    blog: number;
    tags: number;
  }

  const dataEl = document.getElementById("terminal-data");
  const terminalData: TerminalData = JSON.parse(
    dataEl?.textContent ?? '{"blog":[],"ctf":[]}'
  );

  const statsEl = document.getElementById("terminal-stats");
  const terminalStats: TerminalStats | null = statsEl
    ? JSON.parse(statsEl.textContent ?? "null")
    : null;

  let cwd = "/";
  const history: string[] = [];
  let historyIndex = -1;

  const output = document.getElementById("terminal-output");
  const input = document.getElementById("terminal-input") as HTMLInputElement | null;
  const modal = document.getElementById("terminal-modal");
  const matrixCanvas = document.getElementById("matrix-canvas") as HTMLCanvasElement | null;
  let matrixInterval: number | null = null;
  let matrixCtx: CanvasRenderingContext2D | null = null;
  let previousTerminalFocus: HTMLElement | null = null;

  const printLine = (text: string) => {
    if (!output) return;
    const line = document.createElement("div");
    line.className = "mb-1 whitespace-pre-wrap break-words";
    line.textContent = text;
    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
  };

  const printHtml = (html: string) => {
    if (!output) return;
    const line = document.createElement("div");
    line.className = "mb-1 whitespace-pre-wrap break-words";
    line.innerHTML = html;
    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
  };

  const formatPrompt = () => `kyrux@labs:${cwd}$`;

  const open = () => {
    previousTerminalFocus = document.activeElement as HTMLElement | null;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
    document.getElementById("terminal-toggle")?.setAttribute("aria-expanded", "true");
    input?.focus();
    if (output && output.childElementCount === 0) {
      printLine("Kyrux Research Terminal v2.1");
      printLine(
        "Type 'help' for commands. Try 'stats' or 'search xss'."
      );
    }
    // Auto-run command if set by the invoker
    if ((window as any).__terminalAutoCmd) {
      const autoCmd = (window as any).__terminalAutoCmd as string;
      (window as any).__terminalAutoCmd = undefined;
      setTimeout(() => {
        runCommand(autoCmd);
      }, 50);
    }
  };

  const close = () => {
    stopMatrix(); // stop matrix rain if active
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
    const toggleBtn = document.getElementById("terminal-toggle");
    if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "false");
    previousTerminalFocus?.focus();
    previousTerminalFocus = null;
  };

  // Expose for BaseLayout keyboard shortcut (Ctrl+`)
  (window as any).terminalAPI = { open, close };

  const normalizePath = (p: string) => {
    if (!p) return "/";
    if (p === "~") return "/";
    if (!p.startsWith("/")) {
      if (cwd === "/") return `/${p}`;
      return `${cwd.replace(/\/$/, "")}/${p}`;
    }
    return p;
  };

  const cleanPath = (p: string) => {
    const parts = p.split("/").filter(Boolean);
    const stack: string[] = [];
    for (const part of parts) {
      if (part === ".") continue;
      if (part === "..") stack.pop();
      else stack.push(part);
    }
    return `/${stack.join("/")}`;
  };

  const isDir = (p: string) => ["/", "/blog", "/ctf"].includes(p);

  const listDir = (dir = cwd): string[] => {
    if (dir === "/") return ["blog/", "ctf/", "about.txt", "tags/"];
    if (dir === "/blog") return terminalData.blog.map((item) => item.slug);
    if (dir === "/ctf") return terminalData.ctf.map((item) => item.slug);
    return [];
  };

  const lsRoot = () => {
    if (!terminalStats) {
      printLine("blog/  ctf/  about.txt");
      return;
    }
    const c = terminalStats.ctf;
    const b = terminalStats.blog;
    const t = terminalStats.tags;
    printHtml(`
      <span style="color:#c7193f">blog/</span>   <span style="color:#a3a3a3">(${b} posts)</span>
      <span style="color:#c7193f">ctf/</span>    <span style="color:#a3a3a3">(${c} write-ups)</span>
      <span style="color:#c7193f">tags/</span>   <span style="color:#a3a3a3">(${t} topics)</span>
      <span style="color:#a3a3a3">about.txt</span>
    `.split("\n").map(s => s.trim()).join("\n").trim());
  };

  const resolveItem = (name: string): TerminalItem | null => {
    if (cwd === "/blog")
      return terminalData.blog.find((item) => item.slug === name) ?? null;
    if (cwd === "/ctf")
      return terminalData.ctf.find((item) => item.slug === name) ?? null;
    return null;
  };

  const completions = (partial: string): string[] => {
    const commands = [
      "help", "ls", "cd", "pwd", "cat", "open",
      "whoami", "clear", "tree", "search", "stats",
      "fortune", "matrix", "neofetch", "crt", "cursor",
    ];
    const fileSystem =
      cwd === "/"
        ? ["blog", "ctf", "about.txt"]
        : listDir().map((item) => item.replace("/", ""));
    return [...commands, ...fileSystem].filter((item) =>
      item.startsWith(partial)
    );
  };

  const printHelp = () => {
    printLine("Commands:");
    printLine("  ls               - list directory");
    printLine("  cd <dir>         - change dir (/, blog, ctf, ..)");
    printLine("  pwd              - print cwd");
    printLine("  tree             - show sections");
    printLine("  cat <name>       - show entry meta/about.txt");
    printLine("  open <name>      - open entry in new tab");
    printLine("  search <keyword> - search across blog + ctf");
    printLine("  stats            - repository statistics");
    printLine("  whoami           - about");
    printLine("  fortune          - random hacker wisdom");
    printLine("  matrix           - matrix rain (in terminal)");
    printLine("  neofetch         - show system info");
    printLine("  crt [on|off]     - toggle CRT scanlines overlay");
    printLine("  cursor [on|off]  - toggle matrix cursor trail");
    printLine("  clear            - clear screen (Ctrl+L)");
  };

  const printStats = () => {
    if (!terminalStats) {
      printLine("stats: no data available");
      return;
    }
    const c = terminalStats.ctf;
    const b = terminalStats.blog;
    const t = terminalStats.tags;
    const total = c + b;

    printHtml(`
      <span style="color:#a3a3a3">┌── repos</span>
      <span style="color:#a3a3a3">│</span>
      <span style="color:#a3a3a3">├── ctf/</span>  <span style="color:#c7193f;font-weight:bold">${c}</span> write-ups
      <span style="color:#a3a3a3">├── blog/</span> <span style="color:#c7193f;font-weight:bold">${b}</span> research posts
      <span style="color:#a3a3a3">├── tags/</span> <span style="color:#c7193f;font-weight:bold">${t}</span> topics
      <span style="color:#a3a3a3">│</span>
      <span style="color:#a3a3a3">└── total:</span> <span style="color:#c7193f;font-weight:bold">${total}</span> published articles
    `.split("\n").map(s => s.trim()).join("\n").trim());
  };

  // Matrix rain effect (proposal 10)
  const startMatrix = () => {
    if (!matrixCanvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      printLine("Matrix rain is disabled while reduced motion is enabled.");
      return;
    }
    matrixCanvas.classList.remove("hidden");
    const canvasWidth = matrixCanvas.offsetWidth;
    const canvasHeight = matrixCanvas.offsetHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    matrixCanvas.width = Math.round(canvasWidth * dpr);
    matrixCanvas.height = Math.round(canvasHeight * dpr);
    matrixCtx = matrixCanvas.getContext("2d");
    if (!matrixCtx) return;
    matrixCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const chars = "01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワン0123456789".split("");
    const fontSize = 14;
    const columns = canvasWidth / fontSize;
    const drops: number[] = [];

    for (let x = 0; x < columns; x++) drops[x] = Math.random() * canvasHeight / fontSize;

    const draw = () => {
      if (!matrixCtx) return;
      matrixCtx.fillStyle = "rgba(0, 0, 0, 0.05)";
      matrixCtx.fillRect(0, 0, canvasWidth, canvasHeight);
      matrixCtx.fillStyle = "#c7193f";
      matrixCtx.font = `${fontSize}px monospace`;

      for (let i = 0; i < drops.length; i++) {
        const text = chars[Math.floor(Math.random() * chars.length)];
        matrixCtx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > canvasHeight && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }
    };

    matrixInterval = window.setInterval(draw, 35);
    printLine("Matrix rain started. Type 'matrix stop' to exit.");
  };

  const stopMatrix = () => {
    if (matrixInterval) {
      clearInterval(matrixInterval);
      matrixInterval = null;
    }
    if (matrixCanvas) {
      matrixCanvas.classList.add("hidden");
      const ctx = matrixCanvas.getContext("2d");
      if (ctx) ctx.clearRect(0, 0, matrixCanvas.width, matrixCanvas.height);
    }
    printLine("Matrix rain stopped.");
  };

  const runSearch = (query: string) => {
    const q = (query ?? "").trim().toLowerCase();
    if (q.length < 2) {
      printLine("search: query too short (min 2 chars)");
      return;
    }
    const hits: (TerminalItem & { kind: string })[] = [];
    for (const item of terminalData.blog ?? []) {
      const hay = `${item.slug} ${item.title} ${item.summary}`.toLowerCase();
      if (hay.includes(q)) hits.push({ ...item, kind: "blog" });
    }
    for (const item of terminalData.ctf ?? []) {
      const hay = `${item.slug} ${item.title} ${item.summary}`.toLowerCase();
      if (hay.includes(q)) hits.push({ ...item, kind: "ctf" });
    }
    if (hits.length === 0) {
      printLine("No results.");
      return;
    }
    hits.slice(0, 10).forEach((hit) => {
      printLine(`[${hit.kind}] ${hit.slug}  →  ${hit.title}`);
    });
    if (hits.length > 10) printLine(`...and ${hits.length - 10} more`);
  };

  const runCommand = (rawInput: string) => {
    const [cmd, ...args] = rawInput.trim().split(/\s+/);
    if (!cmd) return;

    if (cmd === "help") { printHelp(); return; }
    if (cmd === "clear") { if (output) output.innerHTML = ""; return; }
    if (cmd === "pwd") { printLine(cwd); return; }
    if (cmd === "ls") {
      if (cwd === "/") { lsRoot(); }
      else { printLine(listDir().join("  ")); }
      return;
    }

    // fortune - random hacker wisdom / cyber tips
    if (cmd === "fortune") {
      const quotes = [
        "There is no patch for human stupidity. — 0x41414141",
        "The quieter you become, the more you can hear. — hacker proverb",
        "Trust but verify. Especially your own code.",
        "If you can't fix it with duct tape, you haven't used enough.",
        "RTFM before you ask in #offsec.",
        "All your base are belong to us. — 1991",
        "Never trust a computer you can't throw out a window.",
        "Debugging is twice as hard as writing the code in the first place.",
        "The best way to predict the future is to create it. — with exploits.",
        "In God we trust. All others must bring data... and a shell.",
        "rm -rf / is not a solution. It's a cry for help.",
        "There are 10 types of people: those who understand binary and those who don't."
      ];
      const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
      printHtml(`<span style="color:#eab308">★</span> ${randomQuote}`);
      return;
    }

    if (cmd === "cd") {
      const nextRaw = args[0] ?? "/";
      const next = cleanPath(normalizePath(nextRaw));
      if (!isDir(next)) {
        printLine(`cd: no such directory: ${nextRaw}`);
        return;
      }
      cwd = next;
      return;
    }

    if (cmd === "tree") {
      printLine("/");
      printLine("├── blog/");
      printLine("├── ctf/");
      printLine("├── tags/");
      printLine("└── about.txt");
      return;
    }

    if (cmd === "cat") {
      const target = args[0];
      if (!target) { printLine("cat: missing operand"); return; }
      if (cwd === "/" && target === "about.txt") {
        printLine(
          "Kyrux - cybersecurity researcher focused on web exploitation, CTF write-ups, and practical offensive tooling."
        );
        return;
      }
      const item = resolveItem(target);
      if (!item) { printLine(`cat: ${target}: No such file`); return; }
      printLine(`${item.title}\n${item.summary}\n${item.url}`);
      return;
    }

    if (cmd === "open") {
      const target = args[0];
      if (!target) { printLine("open: missing operand"); return; }
      const item = resolveItem(target);
      if (!item) { printLine(`open: ${target}: No such entry`); return; }
      window.open(item.url, "_blank", "noopener");
      printLine(`Opened ${item.url}`);
      return;
    }

    if (cmd === "search") { runSearch(args.join(" ")); return; }
    if (cmd === "stats") { printStats(); return; }
    if (cmd === "whoami") {
      printLine("kyrux (security researcher | web exploitation | CTF player)");
      return;
    }

    if (cmd === "neofetch") {
      printHtml(`
        <span style="color:#c7193f">       ▄▄████▄▄</span>    <span style="color:#a3a3a3">kyrux@labs</span>
        <span style="color:#c7193f">     ▄██████████▄</span>  <span style="color:#eab308">OS</span>: Kyrux Labs OS v2.1
        <span style="color:#c7193f">   ▄███▀▀    ▀▀███▄</span> <span style="color:#eab308">Host</span>: GitHub Pages
        <span style="color:#c7193f">  ▄██▀          ▀██▄</span> <span style="color:#eab308">Uptime</span>: since 2024
        <span style="color:#c7193f">  ██              ██</span>  <span style="color:#eab308">Shell</span>: kyrux-terminal
        <span style="color:#c7193f">  ██   ████████   ██</span>  <span style="color:#eab308">CPU</span>: Intel i9 (metaphorical)
        <span style="color:#c7193f">  ▀██▄          ▄██▀</span>  <span style="color:#eab308">Memory</span>: ${terminalStats ? terminalStats.blog + terminalStats.ctf : '?'} articles
        <span style="color:#c7193f">    ▀███▄▄    ▄███▀</span>   <span style="color:#eab308">Terminal</span>: v2.1
        <span style="color:#c7193f">      ▀██████████▀</span>    <span style="color:#eab308">Resolution</span>: 1337x420
        <span style="color:#c7193f">        ▀▀████▀▀</span>
      `.trim());
      return;
    }

    if (cmd === "matrix") {
      const subCmd = args[0];
      if (subCmd === "stop") {
        stopMatrix();
      } else {
        startMatrix();
      }
      return;
    }

    if (cmd === "crt") {
      const subCmd = args[0];
      const html = document.documentElement;
      if (subCmd === "off") {
        html.removeAttribute("data-crt");
        localStorage.setItem("crt-enabled", "false");
        printLine("CRT mode disabled.");
      } else {
        html.setAttribute("data-crt", "true");
        localStorage.setItem("crt-enabled", "true");
        printLine("CRT mode enabled. Scanlines, vignette, and flicker active.");
      }
      return;
    }

    if (cmd === "cursor") {
      const subCmd = args[0];
      if (subCmd === "off") {
        window.dispatchEvent(new CustomEvent("cursor-trail-stop"));
        localStorage.setItem("cursor-trail-enabled", "false");
        printLine("Cursor trail disabled.");
      } else {
        window.dispatchEvent(new CustomEvent("cursor-trail-start"));
        localStorage.setItem("cursor-trail-enabled", "true");
        printLine("Cursor trail enabled. Move your mouse to see matrix particles.");
      }
      return;
    }

    printLine(`${cmd}: command not found`);
  };

  // Event bindings
  document.getElementById("terminal-toggle")?.addEventListener("click", open);
  document.getElementById("terminal-close")?.addEventListener("click", close);
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) close();
  });
  modal?.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const focusable = Array.from(
      modal.querySelectorAll<HTMLElement>('button:not([disabled]), input:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'),
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });

  document.getElementById("terminal-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const value = input?.value ?? "";
    if (value.trim()) {
      history.push(value.trim());
      historyIndex = history.length;
    }
    printLine(`${formatPrompt()} ${value}`);
    runCommand(value);
    if (input) input.value = "";
    updateSuggestion();
  });

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { close(); return; }
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "l") {
      event.preventDefault();
      if (output) output.innerHTML = "";
      return;
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      if (history.length === 0) return;
      historyIndex = Math.max(0, historyIndex - 1);
      if (input) { input.value = history[historyIndex] ?? ""; updateSuggestion(); }
      return;
    }
    if (event.key === "ArrowDown") {
      event.preventDefault();
      if (history.length === 0) return;
      historyIndex = Math.min(history.length, historyIndex + 1);
      if (input) {
        input.value = historyIndex >= history.length ? "" : history[historyIndex];
        updateSuggestion();
      }
      return;
    }
    if (event.key === "Tab") {
      // If autosuggestion is showing, complete it
      const ghostEl = document.getElementById("terminal-ghost");
      const ghostText = ghostEl?.textContent ?? "";
      if (ghostText) {
        event.preventDefault();
        if (input) input.value = (input.value ?? "") + ghostText + " ";
        updateSuggestion();
        return;
      }
      // Fallback to old tab-completion
      const current = input?.value?.trim() ?? "";
      const parts = current.split(/\s+/);
      const partial = parts[parts.length - 1] ?? "";
      const matches = completions(partial);
      if (matches.length === 1) {
        event.preventDefault();
        parts[parts.length - 1] = matches[0];
        if (input) input.value = parts.join(" ") + " ";
      } else if (matches.length > 1) {
        event.preventDefault();
        printLine(matches.join("  "));
      }
    }
    if (event.key === "ArrowRight") {
      // Accept autosuggestion on right arrow
      const ghostEl = document.getElementById("terminal-ghost");
      const ghostText = ghostEl?.textContent ?? "";
      if (ghostText) {
        event.preventDefault();
        if (input) input.value = (input.value ?? "") + ghostText + " ";
        updateSuggestion();
      }
    }
  });

  // ---------- Inline autosuggestion ----------
  const updateSuggestion = () => {
    const typedEl = document.getElementById("terminal-typed");
    const ghostEl = document.getElementById("terminal-ghost");
    if (!typedEl || !ghostEl || !input) return;

    const current = input.value ?? "";
    typedEl.textContent = current;

    if (current.length === 0) {
      ghostEl.textContent = "";
      return;
    }

    // Find best match from commands (by first char)
    const allCommands = completions("");
    const lc = current.toLowerCase();
    const match = allCommands.find(cmd => cmd.startsWith(lc) && cmd !== lc);
    if (match) {
      ghostEl.textContent = match.slice(lc.length);
    } else {
      ghostEl.textContent = "";
    }
  };

  input?.addEventListener("input", updateSuggestion);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal?.classList.contains("flex")) {
      close();
    }
  });
</script>
