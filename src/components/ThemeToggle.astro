<!--
  ThemeToggle – switches between "dark" (default) and "dim" mode.
  Persists preference to localStorage.
-->
<script>
  const root = document.documentElement;
  const saved = localStorage.getItem("kyrux-theme") ?? "dark";
  root.dataset.theme = saved;

  function updateIcon(btn: HTMLElement | null) {
    if (!btn) return;
    btn.textContent = root.dataset.theme === "dim" ? "☀️" : "🌙";
  }

  const toggle = document.getElementById("theme-toggle");
  updateIcon(toggle);

  toggle?.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "dim" ? "dark" : "dim";
    localStorage.setItem("kyrux-theme", root.dataset.theme);
    updateIcon(toggle);
  });
</script>

<button
  id="theme-toggle"
  type="button"
  class="rounded-md px-2 py-1 text-sm text-neutral-400 hover:text-cyan-300"
  title="Toggle theme"
>
  🌙
</button>
