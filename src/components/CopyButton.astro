<!--
  CopyButton – attaches "Copy" buttons + language badges to every <pre> block inside .prose.
-->
<script>
  const preBlocks = Array.from(document.querySelectorAll(".prose pre"));

  preBlocks.forEach((pre) => {
    if (pre.querySelector(".copy-code-btn")) return;
    pre.classList.add("relative");

    // --- Language badge from data-language ---
    const lang = pre.getAttribute("data-language");
    if (lang && !pre.querySelector(".code-lang-badge")) {
      const badge = document.createElement("span");
      badge.textContent = lang;
      badge.className =
        "code-lang-badge absolute left-3 top-3 rounded border border-neutral-700/60 bg-neutral-800/80 backdrop-blur-sm px-2 py-0.5 font-mono text-[10px] tracking-wider text-neutral-500";
      pre.appendChild(badge);
    }

    // --- Copy button ---
    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "Copy";
    button.className =
      "copy-code-btn absolute right-3 top-3 rounded border border-neutral-700 bg-neutral-800 px-2 py-1 text-xs text-neutral-300 hover:border-cyan-500 hover:text-cyan-300";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      if (!code) return;
      const raw = code.innerText;
      try {
        await navigator.clipboard.writeText(raw);
        button.textContent = "Copied";
        setTimeout(() => (button.textContent = "Copy"), 1200);
      } catch {
        button.textContent = "Error";
        setTimeout(() => (button.textContent = "Copy"), 1200);
      }
    });

    pre.appendChild(button);
  });
</script>
