<!--
  ImageLightbox – click-to-zoom overlay for .prose images.
  Hydrated with client:visible for lazy activation.
-->
<div id="image-lightbox" class="lightbox" data-open="false" aria-hidden="true">
  <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Image viewer">
    <div class="lightbox-toolbar">
      <div id="lightbox-title" class="lightbox-title">image</div>
      <button id="lightbox-close" type="button" class="lightbox-close">Close</button>
    </div>
    <div class="lightbox-body">
      <img id="lightbox-img" class="lightbox-img" alt="" />
    </div>
  </div>
</div>

<script>
  const lightbox = document.getElementById("image-lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxTitle = document.getElementById("lightbox-title");
  const lightboxClose = document.getElementById("lightbox-close");

  const openLightbox = (img: HTMLImageElement) => {
    const src = img.currentSrc || img.src;
    if (!src) return;
    lightboxImg.src = src;
    lightboxImg.alt = img.alt || "image";
    if (lightboxTitle)
      lightboxTitle.textContent =
        img.alt || src.split("/").pop() || "image";
    lightbox.dataset.open = "true";
    lightbox.setAttribute("aria-hidden", "false");
    document.documentElement.style.overflow = "hidden";
  };

  const closeLightbox = () => {
    lightbox.dataset.open = "false";
    lightbox.setAttribute("aria-hidden", "true");
    lightboxImg.src = "";
    document.documentElement.style.overflow = "";
  };

  document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
    img.loading = img.loading || "lazy";
    img.decoding = img.decoding || "async";
    img.setAttribute("data-zoomable", "true");
    img.addEventListener("click", () => openLightbox(img));
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox.dataset.open === "true") {
      closeLightbox();
    }
  });
</script>
