---
interface MemoryFrame {
  src: string;
  width: number;
  height: number;
  caption: string;
  focalX?: number;
  focalY?: number;
}

interface PortraitFrame {
  src: string;
  width: number;
  height: number;
}

interface Props {
  frames: MemoryFrame[];
  paintedMemories: string[];
  portraits: PortraitFrame[];
}

const { frames, paintedMemories, portraits } = Astro.props;
---

<section
  id="rose-memory-cinema"
  class="rose-memory-cinema"
  aria-label="Bộ phim ký ức Rose Door"
  aria-describedby="rose-cinema-description"
  aria-hidden="true"
  tabindex="-1"
  inert
>
  <p id="rose-cinema-description" class="rose-cinema-sr">
    Một đàn dơi rời khỏi cánh cửa, hóa thành cánh hoa và ánh sao. Hai chòm sao giữ lại những mảnh ký ức trên bầu trời trước khi chúng hội tụ thành hoa hồng và lời cảm ơn cuối cùng.
  </p>
  <canvas id="rose-cinema-canvas" class="rose-cinema-canvas" aria-hidden="true" tabindex="-1"></canvas>

  <div class="rose-cinema-depth" aria-hidden="true">
    <i></i><i></i><i></i>
  </div>
  <div class="rose-cinema-fallback" aria-hidden="true">
    <span class="rose-fallback-orbit rose-fallback-orbit--one"></span>
    <span class="rose-fallback-orbit rose-fallback-orbit--two"></span>
    <span class="rose-fallback-bloom"><i></i><i></i><i></i><i></i><i></i><i></i></span>
  </div>

  <p id="rose-cinema-thanks" class="rose-cinema-thanks" aria-hidden="true">
    <span class="rose-cinema-thanks__ornament" aria-hidden="true">✦</span>
    <strong aria-hidden="true">
      <span class="rose-cinema-thanks__glyph" style="--glyph: 0">T</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 1">h</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 2">a</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 3">n</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 4">k</span>
      <i class="rose-cinema-thanks__space" aria-hidden="true"></i>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 5">y</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 6">o</span>
      <span class="rose-cinema-thanks__glyph" style="--glyph: 7">u</span>
    </strong>
    <span class="rose-cinema-thanks__ornament" aria-hidden="true">✦</span>
    <span class="rose-cinema-sr">Thank you</span>
  </p>

  <div class="rose-cinema-vignette" aria-hidden="true"></div>
  <div class="rose-cinema-lumens" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
  <div class="rose-cinema-grain" aria-hidden="true"></div>
  <div class="rose-cinema-bars" aria-hidden="true"><i></i><i></i></div>

  <div class="rose-cinema-controls" role="group" aria-label="Điều khiển bộ phim">
    <button id="rose-cinema-pause" type="button" aria-label="Tạm dừng bộ phim" aria-pressed="false">
      <svg class="rose-icon rose-icon--pause" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14M16 5v14"></path>
      </svg>
      <svg class="rose-icon rose-icon--play" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m8 5 11 7-11 7Z"></path>
      </svg>
      <span id="rose-cinema-pause-copy" class="rose-cinema-ctrl-label">Tạm dừng</span>
    </button>
    <button id="rose-cinema-skip" type="button" aria-label="Bỏ qua bộ phim" aria-keyshortcuts="Escape">
      <svg class="rose-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 6 7 6-7 6V6Zm8 0 7 6-7 6V6Z"></path>
      </svg>
      <span class="rose-cinema-ctrl-label">Bỏ qua</span>
    </button>
  </div>

  <div class="rose-cinema-progress" aria-hidden="true">
    <span id="rose-cinema-progress-fill"></span>
    <i class="rose-cinema-progress-glow"></i>
  </div>
  <p id="rose-cinema-status" class="rose-cinema-sr" role="status" aria-live="polite"></p>

  <div class="rose-cinema-textures" aria-hidden="true">
    {frames.map((frame, index) => (
      <img
        data-rose-texture={`photo-${index}`}
        data-rose-role="hero"
        data-focal-x={frame.focalX ?? .5}
        data-focal-y={frame.focalY ?? .5}
        src={frame.src}
        width={frame.width}
        height={frame.height}
        alt=""
        decoding="async"
      />
    ))}
    {paintedMemories.map((src, index) => (
      <img data-rose-texture={`painted-${index}`} data-rose-role="glimpse" src={src} width="560" height="560" alt="" decoding="async" />
    ))}
    {portraits.map((portrait, index) => (
      <img
        data-rose-texture={`portrait-${index}`}
        data-rose-role="portrait"
        src={portrait.src}
        width={portrait.width}
        height={portrait.height}
        alt=""
        decoding="async"
      />
    ))}
  </div>
</section>

<script>
  const cinemaRoot = document.querySelector<HTMLElement>("#rose-memory-cinema");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  type RoseCinemaEngine = {
    start: (startAt?: number) => void;
    pause: () => void;
    resume: () => void;
    reset: () => void;
    destroy: () => void;
  };

  let enginePromise: Promise<RoseCinemaEngine | null> | undefined;
  let fallbackTimer = 0;
  let fallbackPaused = false;
  let runRequest = 0;
  let requestedPause = false;

  function resetFinaleStages() {
    cinemaRoot?.classList.remove("is-paper-in", "is-paper-out", "is-thanks-in");
    delete cinemaRoot?.dataset.roseFinale;
  }

  function emit(name: string, detail: Record<string, unknown> = {}) {
    cinemaRoot?.dispatchEvent(new CustomEvent(name, { detail }));
  }

  async function ensureEngine() {
    if (!cinemaRoot || reducedMotion.matches) return null;
    if (!enginePromise) {
      cinemaRoot.classList.add("is-loading");
      enginePromise = Promise.all([
        import("../scripts/rose-cinema-film"),
      ])
        .then(([{ createRoseCinemaFilm }]) => createRoseCinemaFilm(cinemaRoot, {
          onProgress: (progress: number) => {
            const fill = cinemaRoot.querySelector<HTMLElement>("#rose-cinema-progress-fill");
            if (fill) fill.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
          },
          onCue: (cue: string) => emit("rose-cinema:cue", { cue }),
          onComplete: () => emit("rose-cinema:complete"),
        }))
        .then((engine) => {
          cinemaRoot.classList.remove("is-loading");
          return engine;
        })
        .catch((error) => {
          console.warn("Rose cinema switched to its lightweight fallback.", error);
          cinemaRoot.classList.remove("is-loading");
          cinemaRoot.classList.add("is-fallback");
          const status = cinemaRoot.querySelector<HTMLElement>("#rose-cinema-status");
          if (status) status.textContent = "Đã chuyển sang chế độ hiệu ứng nhẹ.";
          return null;
        });
    }
    return enginePromise;
  }

  cinemaRoot?.addEventListener("rose-cinema:command", async (event) => {
    const { command, startAt } = (event as CustomEvent<{ command?: string; startAt?: number }>).detail ?? {};

    // Prepare is intentionally side-effect free from the viewer's perspective:
    // it compiles the renderer, uploads textures, and leaves the first frame
    // ready so the subsequent `start` command does not hitch on the door cut.
    if (command === "prepare") {
      if (!reducedMotion.matches) await ensureEngine();
      return;
    }

    if (command === "start") {
      const request = ++runRequest;
      window.clearTimeout(fallbackTimer);
      resetFinaleStages();
      fallbackPaused = false;
      requestedPause = false;
      if (reducedMotion.matches) {
        emit("rose-cinema:complete", { reduced: true });
        return;
      }
      const engine = await ensureEngine();
      if (request !== runRequest) return;
      if (engine) {
        engine.start(typeof startAt === "number" ? startAt : 0);
        if (requestedPause) engine.pause();
      } else {
        fallbackTimer = window.setTimeout(() => emit("rose-cinema:complete", { fallback: true }), 2100);
      }
      return;
    }

    if (command === "pause") requestedPause = true;
    if (command === "resume") requestedPause = false;
    if (command === "reset" || command === "destroy") {
      runRequest += 1;
      requestedPause = false;
      resetFinaleStages();
    }
    const engine = await enginePromise;
    if (!engine) {
      if (command === "pause") {
        fallbackPaused = true;
        window.clearTimeout(fallbackTimer);
      }
      if (command === "resume" && fallbackPaused) {
        fallbackPaused = false;
        fallbackTimer = window.setTimeout(() => emit("rose-cinema:complete", { fallback: true }), 900);
      }
      if (command === "reset" || command === "destroy") {
        window.clearTimeout(fallbackTimer);
        fallbackPaused = false;
      }
      return;
    }
    if (command === "pause") engine.pause();
    if (command === "resume") engine.resume();
    if (command === "reset") engine.reset();
    if (command === "destroy") {
      engine.destroy();
      enginePromise = undefined;
      cinemaRoot.classList.remove("is-cinema-ready", "is-loading");
    }
  });

  cinemaRoot?.addEventListener("rose-cinema:cue", (event) => {
    const { cue } = (event as CustomEvent<{ cue?: string }>).detail ?? {};
    if (cue === "finale") cinemaRoot.dataset.roseFinale = "true";
    if (cue === "paper-in") {
      cinemaRoot.classList.remove("is-paper-out", "is-thanks-in");
      cinemaRoot.classList.add("is-paper-in");
    }
    if (cue === "paper-out") {
      cinemaRoot.classList.remove("is-paper-in");
      cinemaRoot.classList.add("is-paper-out");
    }
    if (cue === "thanks") {
      cinemaRoot.classList.remove("is-paper-in", "is-paper-out");
      cinemaRoot.classList.add("is-thanks-in");
      const status = cinemaRoot.querySelector<HTMLElement>("#rose-cinema-status");
      if (status) status.textContent = "Thank you.";
    }
  });

  // The page controller may already be waiting to start the film.  Announce
  // readiness only after the command listener is installed, so that a slow
  // module load cannot lose the first start command.
  emit("rose-cinema:ready");

  reducedMotion.addEventListener("change", (event) => {
    if (event.matches) enginePromise?.then((engine) => engine?.reset());
    if (event.matches) {
      runRequest += 1;
      requestedPause = false;
    }
  });

  window.addEventListener("pagehide", (event) => {
    if (event.persisted) return;
    runRequest += 1;
    window.clearTimeout(fallbackTimer);
    resetFinaleStages();
    enginePromise?.then((engine) => engine?.destroy());
  });
</script>

<style is:global>
  :root {
    --rose-ink-plum: #12070f;
    --rose-oxblood: #68111c;
    --rose-crimson: #b52432;
    --rose-bone: #f2e5cf;
    --rose-gold: #b08b4f;
  }

  body.rose-cinema-lock {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .rose-memory-cinema {
    position: fixed;
    z-index: 26;
    inset: 0;
    overflow: hidden;
    color: var(--rose-bone);
    background:
      radial-gradient(ellipse at 50% 62%, rgba(150, 23, 47, .17), transparent 31%),
      radial-gradient(ellipse at 76% 24%, rgba(80, 36, 84, .16), transparent 26%),
      linear-gradient(145deg, #070308, #12070f 58%, #030204);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    isolation: isolate;
    transition: opacity 720ms cubic-bezier(.22, .61, .36, 1), visibility 0s linear 720ms;
  }

  .rose-memory-cinema.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .rose-memory-cinema.is-active.is-handoff {
    background: transparent;
    opacity: 1;
    transition: none;
  }

  .rose-memory-cinema.is-handoff .rose-cinema-canvas {
    opacity: 1;
    transition: none;
  }

  .rose-memory-cinema.is-handoff .rose-cinema-controls,
  .rose-memory-cinema.is-handoff .rose-cinema-progress,
  .rose-memory-cinema.is-handoff .rose-cinema-bars,
  .rose-memory-cinema.is-handoff .rose-cinema-grain,
  .rose-memory-cinema.is-handoff .rose-cinema-vignette { opacity: 0; }

  .rose-memory-cinema.is-handoff .rose-cinema-controls {
    visibility: hidden;
    pointer-events: none;
  }

  .rose-memory-cinema.is-closing {
    opacity: 0;
    pointer-events: none;
  }

  .rose-cinema-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 650ms ease;
  }

  .rose-memory-cinema.is-cinema-ready .rose-cinema-canvas { opacity: 1; }
  /* The canvas owns the active shot. Hiding the decorative depth planes and
     calming the grain leaves the illustration luminous rather than noisy. */
  .rose-memory-cinema.is-cinema-ready .rose-cinema-depth { display: none; }
  .rose-memory-cinema.is-cinema-ready .rose-cinema-grain {
    opacity: .026;
    mix-blend-mode: normal;
    animation: none;
    transform: none;
  }
  .rose-memory-cinema.is-paused .rose-cinema-depth i,
  .rose-memory-cinema.is-paused .rose-cinema-grain,
  .rose-memory-cinema.is-paused .rose-cinema-fallback,
  .rose-memory-cinema.is-paused .rose-fallback-orbit,
  .rose-memory-cinema.is-paused .rose-fallback-bloom { animation-play-state: paused; }

  .rose-cinema-depth {
    position: absolute;
    z-index: 0;
    inset: -10%;
    overflow: hidden;
    pointer-events: none;
  }

  .rose-cinema-depth i {
    position: absolute;
    inset: 18%;
    border: 1px solid rgba(176, 139, 79, .11);
    border-radius: 50%;
    transform: rotateX(68deg) rotateZ(18deg);
    animation: rose-depth-turn 22s linear infinite;
  }

  .rose-cinema-depth i:nth-child(2) { inset: 4%; animation-duration: 34s; animation-direction: reverse; }
  .rose-cinema-depth i:nth-child(3) { inset: -18%; animation-duration: 48s; }
  .rose-cinema-fallback {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(.72);
    transition: opacity 500ms ease, transform 2s cubic-bezier(.16, 1, .3, 1);
  }

  .rose-memory-cinema.is-loading .rose-cinema-fallback,
  .rose-memory-cinema.is-fallback .rose-cinema-fallback {
    opacity: 1;
    transform: scale(1);
  }

  .rose-fallback-orbit {
    position: absolute;
    width: min(68vw, 38rem);
    aspect-ratio: 1;
    border: 1px solid rgba(176, 139, 79, .24);
    border-radius: 50%;
    animation: rose-fallback-orbit 8s linear infinite;
  }

  .rose-fallback-orbit--two {
    width: min(88vw, 52rem);
    border-color: rgba(181, 36, 50, .18);
    animation-direction: reverse;
    animation-duration: 13s;
  }

  .rose-fallback-bloom {
    position: relative;
    width: clamp(7rem, 18vw, 12rem);
    aspect-ratio: 1;
    filter: drop-shadow(0 0 2.6rem rgba(181, 36, 50, .38));
    animation: rose-fallback-breathe 2.1s ease-in-out infinite alternate;
  }

  .rose-fallback-bloom i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42%;
    height: 62%;
    border: 1px solid rgba(242, 229, 207, .26);
    border-radius: 76% 12% 72% 18%;
    background: linear-gradient(145deg, #8f172c, #3b0a16);
    transform-origin: 15% 84%;
    transform: translate(-14%, -84%) rotate(calc(var(--petal) * 60deg));
  }

  .rose-fallback-bloom i:nth-child(1) { --petal: 0; }
  .rose-fallback-bloom i:nth-child(2) { --petal: 1; }
  .rose-fallback-bloom i:nth-child(3) { --petal: 2; }
  .rose-fallback-bloom i:nth-child(4) { --petal: 3; }
  .rose-fallback-bloom i:nth-child(5) { --petal: 4; }
  .rose-fallback-bloom i:nth-child(6) { --petal: 5; }

  .rose-cinema-letter {
    position: absolute;
    z-index: 15;
    top: 50%;
    left: 50%;
    /* The note is a final whisper over the rose, not a full-screen panel. */
    width: min(78vw, 28rem);
    min-height: clamp(18rem, 48vh, 27rem);
    display: grid;
    place-items: center;
    color: #2a1119;
    background:
      linear-gradient(112deg, transparent 0 46%, rgba(104, 17, 28, .04) 47% 48%, transparent 49%),
      radial-gradient(circle at 16% 13%, rgba(255, 246, 218, .82), transparent 19%),
      radial-gradient(circle at 18% 16%, rgba(176, 139, 79, .14), transparent 31%),
      rgba(234, 220, 196, .94);
    border: 1px solid rgba(225, 187, 116, .58);
    clip-path: polygon(0 1.25rem, 1.25rem 0, calc(100% - .75rem) 0, 100% .75rem, 100% calc(100% - 1rem), calc(100% - 1rem) 100%, .65rem 100%, 0 calc(100% - .65rem));
    box-shadow: 0 2.4rem 7rem rgba(0, 0, 0, .62), 0 0 0 1px rgba(71, 15, 31, .23), inset 0 0 5rem rgba(115, 69, 50, .08);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -125vh) scale(.72) rotate(-12deg);
    transform-origin: 50% 72%;
    pointer-events: none;
    transition: opacity 720ms cubic-bezier(.16, 1, .3, 1), transform 720ms cubic-bezier(.16, 1, .3, 1), visibility 0s linear 720ms;
  }

  .rose-cinema-letter::before,
  .rose-cinema-letter::after {
    content: "";
    position: absolute;
    width: 1.1rem;
    aspect-ratio: 1;
    border: 1px solid rgba(104, 17, 28, .4);
    transform: rotate(45deg);
  }

  .rose-cinema-letter::before { top: 1.3rem; left: 1.3rem; border-width: 1px 0 0 1px; }
  .rose-cinema-letter::after { right: 1.3rem; bottom: 1.3rem; border-width: 0 1px 1px 0; }

  /* A physical flyer enters from above, rests completely still for the
     reading beat, then leaves the frame.  Transform + opacity keep this on
     the compositor and avoid the previous breathing filter shimmer. */
  .rose-memory-cinema.is-paper-in .rose-cinema-letter {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
    transition-delay: 0s;
  }

  .rose-memory-cinema.is-paper-out .rose-cinema-letter {
    opacity: 0;
    visibility: visible;
    transform: translate(calc(-50% + 120vw), calc(-50% - 24vh)) scale(.62) rotate(22deg);
    transition: opacity 820ms cubic-bezier(.34, 1.15, .64, 1), transform 820ms cubic-bezier(.34, 1.15, .64, 1), visibility 0s linear 820ms;
  }

  .rose-cinema-letter__inner {
    width: min(78%, 22rem);
    padding: clamp(2.8rem, 8vh, 5.2rem) 0;
  }

  .rose-cinema-letter__inner > p:first-child {
    margin: 0 0 1.2rem;
    color: #68111c;
    font-family: "IBM Plex Mono", monospace;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .rose-cinema-letter h2 {
    margin: 0;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: .96;
  }

  .rose-cinema-letter__inner > p:not(:first-child) {
    margin: 1.35rem 0 0;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    line-height: 1.65;
  }

  .rose-cinema-letter__inner > span {
    display: block;
    margin-top: 1.5rem;
    color: #68111c;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.35rem;
    font-style: italic;
    text-align: right;
  }

  .rose-cinema-letter__rule {
    width: 100%;
    height: 1px;
    margin: 1.55rem 0;
    background: rgba(104, 17, 28, .24);
  }

  .rose-cinema-letter__rule i {
    display: block;
    width: 2.8rem;
    height: 3px;
    background: #b52432;
    transform: translateY(-1px);
  }

  .rose-cinema-thanks {
    position: absolute;
    z-index: 17;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: clamp(.85rem, 2.4vw, 1.45rem);
    margin: 0;
    font-family: "DM Serif Display", Georgia, serif;
    font-size: clamp(3.45rem, 10.6vw, 8.15rem);
    font-weight: 400;
    letter-spacing: -.048em;
    line-height: .9;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(-50%, -50%, 0);
    pointer-events: none;
  }

  .rose-cinema-thanks strong {
    display: inline-flex;
    align-items: baseline;
    color: #fff1d8;
    opacity: 0;
    visibility: hidden;
  }

  .rose-cinema-thanks__glyph {
    display: inline-block;
    color: inherit;
  }

  .rose-cinema-thanks__space { width: .21em; }

  .rose-cinema-thanks__ornament {
    color: #f2a36a;
    font-family: "IBM Plex Mono", monospace;
    font-size: .26em;
    letter-spacing: 0;
    opacity: 0;
    visibility: hidden;
  }

  /* The normal-motion finale is painted entirely by the canvas. This node is
     deliberately visible to assistive technology but visually transparent;
     a solid text fallback is restored only for reduced motion. */
  .rose-memory-cinema.is-thanks-in .rose-cinema-thanks {
    visibility: visible;
    opacity: 0;
  }

  .rose-cinema-vignette {
    position: absolute;
    /* The closing iris is the final edit, so it must pass over the paper as
       well as the canvas. Controls stay available above it at z-index 20. */
    z-index: 16;
    inset: 0;
    pointer-events: none;
    --rose-iris-close: 0;
    background:
      radial-gradient(ellipse at 50% 46%, transparent 40%, rgba(5, 2, 4, .18) 68%, rgba(4, 2, 3, .82) 100%),
      radial-gradient(ellipse at 50% 55%, rgba(145, 24, 48, .06), transparent 55%);
  }

  /* The final iris is a single compositor layer.  The engine only updates
     this opacity at a low cadence, avoiding a costly CSS gradient rewrite on
     every rendered frame. */
  .rose-cinema-vignette::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: var(--rose-iris-close);
    background: radial-gradient(ellipse at 50% 50%, transparent 3%, rgba(4, 2, 3, .74) 34%, #040203 76%);
  }

  .rose-cinema-lumens {
    position: absolute;
    z-index: 13;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .rose-memory-cinema.is-thanks-in .rose-cinema-lumens {
