---
// PostLayout – layout shell for individual blog/CTF posts.
// Renders: title header, tags/chips, quick-nav TOC, JSON-LD, and
// reading-time TOC scroll-spy.
import BaseLayout from "./BaseLayout.astro";
import { estimateReadingTime, withBase } from "../utils";

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
  protected?: boolean;
  /** The full canonical URL of the post. Used for JSON-LD. */
  canonicalUrl?: string;
  /** "blog" or "ctf" — used for the chip label */
  collectionType?: string;
  /** Raw body text for reading time estimate */
  bodyText?: string;
  /** Last modified date (defaults to date) */
  lastModified?: Date;
}

const {
  title,
  date,
  description,
  tags = [],
  headings = [],
  protected: isProtected = false,
  canonicalUrl,
  collectionType = "blog",
  bodyText,
  lastModified,
} = Astro.props;

const chipLabel = collectionType === "ctf" ? "CTF Write-up" : "Research";

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  description: description ?? title,
  author: {
    "@type": "Person",
    name: "Kyrux",
    url: "https://github.com/kyrux29",
  },
  publisher: {
    "@type": "Person",
    name: "Kyrux",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl ?? undefined,
  },
  keywords: tags.join(", "),
};
---

<BaseLayout title={`${title} | Kyrux`} description={description}>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="mx-auto max-w-7xl lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-10">
    <div class="min-w-0">
      <header class="panel mb-6 p-5 sm:p-6">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="chip">{chipLabel}</span>
          {isProtected && <span class="chip chip--hard">Protected</span>}
          {
            tags.map((tag) => (
              <a class="chip hover:text-cyan-300" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            ))
          }
        </div>
        <div class="mb-3 flex flex-wrap items-center gap-2 font-mono text-[10px] tracking-wide">
          <span class="text-neutral-500">
            <time datetime={date.toISOString()}>{date.toLocaleDateString("en-CA")}</time>
          </span>
          {bodyText && (
            <>
              <span class="text-neutral-800">·</span>
              <span class="text-neutral-500">{estimateReadingTime(bodyText)} min read</span>
            </>
          )}
          {lastModified && lastModified > date && (
            <>
              <span class="text-neutral-800">·</span>
              <span class="text-neutral-600">updated {lastModified.toLocaleDateString("en-CA")}</span>
            </>
          )}
        </div>
        <h1 class="text-3xl font-semibold leading-tight text-neutral-100 sm:text-4xl md:text-5xl">{title}</h1>
        {description && <p class="mt-3 max-w-2xl text-sm text-neutral-400 sm:text-base">{description}</p>}
      </header>

      {tocHeadings.length > 0 && (
        <details class="panel mb-5 p-4 lg:hidden">
          <summary class="cursor-pointer text-xs font-semibold tracking-wider text-neutral-300">
            Quick Nav
          </summary>
          <ul class="mt-3 space-y-2 text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-3" : ""}>
                <a href={`#${heading.slug}`} class="toc-link text-neutral-400 hover:text-cyan-300">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="mx-auto max-w-3xl">
        <div
          class="prose prose-invert max-w-none prose-headings:mt-10 prose-headings:tracking-tight prose-h2:text-2xl sm:prose-h2:text-3xl prose-p:leading-7 sm:prose-p:leading-8 prose-pre:rounded-2xl prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-neutral-900 prose-pre:p-4 sm:prose-pre:p-5 prose-pre:text-neutral-100 prose-code:before:content-none prose-code:after:content-none prose-blockquote:rounded-xl prose-blockquote:border-l-4 prose-blockquote:border-cyan-500/80 prose-blockquote:bg-neutral-900 prose-blockquote:px-4 prose-blockquote:py-3 prose-blockquote:text-neutral-300"
        >
        <slot />
        </div>
      </div>
    </div>

    {tocHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <div class="panel sticky top-6 p-4">
          <h2 class="mb-3 text-xs font-semibold tracking-wider text-neutral-400">Quick Nav</h2>
          <ul class="space-y-2 text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-3" : ""}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug} class="toc-link text-neutral-400 hover:text-cyan-300">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </article>

  <!-- TOC scroll-spy (kept inline for performance, tightly coupled to this layout) -->
  <script is:inline>
    (function () {
      const links = Array.from(document.querySelectorAll("[data-toc-link]"));
      const sections = links
        .map(function (link) { return document.getElementById(link.getAttribute("data-toc-link") ?? ""); })
        .filter(Boolean);

      if (links.length > 0 && sections.length > 0) {
        var activate = function (id) {
          links.forEach(function (link) {
            var active = link.getAttribute("data-toc-link") === id;
            link.classList.toggle("toc-active", active);
            link.classList.toggle("text-cyan-300", active);
            link.classList.toggle("font-medium", active);
            link.classList.toggle("text-neutral-400", !active);
          });
        };

        var observer = new IntersectionObserver(
          function (entries) {
            var visible = entries
              .filter(function (entry) { return entry.isIntersecting; })
              .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; })[0];
            if (visible && visible.target && visible.target.id) activate(visible.target.id);
          },
          { rootMargin: "-20% 0px -70% 0px", threshold: 0.1 }
        );

        sections.forEach(function (section) { observer.observe(section); });
        activate(sections[0].id);
      }
    })();
  </script>
</BaseLayout>
