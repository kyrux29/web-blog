---
// PostLayout – layout shell for individual blog/CTF posts.
// Renders: title header, tags/chips, quick-nav TOC, JSON-LD, and
// reading-time TOC scroll-spy.
import BaseLayout from "./BaseLayout.astro";
import { estimateReadingTime, withBase } from "../utils";

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
  protected?: boolean;
  /** The full canonical URL of the post. Used for JSON-LD. */
  canonicalUrl?: string;
  /** "blog" or "ctf" — used for the chip label */
  collectionType?: string;
  /** Raw body text for reading time estimate */
  bodyText?: string;
  /** Last modified date (defaults to date) */
  lastModified?: Date;
  /** Related posts calculated by tag overlap */
  relatedPosts?: any[];
  /** Series name for grouping */
  series?: string;
  /** Current post ID */
  currentPostId?: string;
}

const {
  title,
  date,
  description,
  tags = [],
  headings = [],
  protected: isProtected = false,
  canonicalUrl,
  collectionType = "blog",
  bodyText,
  lastModified,
  relatedPosts = [],
  series,
  currentPostId,
} = Astro.props;

const chipLabel = collectionType === "ctf" ? "CTF Write-up" : "Research";

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  description: description ?? title,
  author: {
    "@type": "Person",
    name: "Kyrux",
    url: "https://github.com/kyrux29",
  },
  publisher: {
    "@type": "Person",
    name: "Kyrux",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl ?? undefined,
  },
  keywords: tags.join(", "),
};
---

<BaseLayout title={`${title} | Kyrux`} description={description}>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="mx-auto max-w-7xl pt-4 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-6">
    <div class="min-w-0">
      <!-- Post Header -->
      <header class="glass-panel mb-6 p-6 sm:p-8">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="chip">{chipLabel}</span>
          {isProtected && <span class="chip chip--hard">Protected</span>}
          {
            tags.map((tag) => (
              <a class="chip hover:text-cyan-300 hover:border-cyan-500/20" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            ))
          }
        </div>
        <div class="mb-4 flex flex-wrap items-center gap-3 font-mono text-[11px] tracking-wide text-neutral-500">
          <time datetime={date.toISOString()}>{date.toLocaleDateString("en-CA")}</time>
          {bodyText && (
            <>
              <span class="text-neutral-700">·</span>
              <span>{estimateReadingTime(bodyText)} min read</span>
            </>
          )}
          {lastModified && lastModified > date && (
            <>
              <span class="text-neutral-700">·</span>
              <span class="text-neutral-600">updated {lastModified.toLocaleDateString("en-CA")}</span>
            </>
          )}
        </div>
        <h1 class="text-3xl font-bold leading-tight text-neutral-100 sm:text-4xl">{title}</h1>
        {description && <p class="mt-4 max-w-2xl text-sm text-neutral-400 leading-relaxed sm:text-base">{description}</p>}
      </header>

      <!-- Quick Nav (mobile) -->
      {tocHeadings.length > 0 && (
        <details class="glass-panel mb-5 p-4 lg:hidden">
          <summary class="cursor-pointer font-mono text-xs font-semibold tracking-wider text-neutral-300">
            Quick Nav
          </summary>
          <ul class="mt-3 space-y-1.5 font-mono text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-4" : ""}>
                <a href={`#${heading.slug}`} class="toc-link text-neutral-400 hover:text-cyan-300">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <!-- Post Content -->
      <div class="glass-content" data-pagefind-body>
        <div
          class="prose prose-invert prose-mono max-w-none prose-headings:mt-10 prose-headings:tracking-tight prose-h2:text-2xl sm:prose-h2:text-3xl prose-p:leading-7 sm:prose-p:leading-8 prose-pre:rounded-sm prose-pre:border-2 prose-pre:border-white/[0.06] prose-pre:bg-neutral-900/60 prose-pre:backdrop-blur-md prose-pre:p-4 sm:prose-pre:p-5 prose-pre:text-neutral-100 prose-code:before:content-none prose-code:after:content-none prose-blockquote:rounded-sm prose-blockquote:border-l-4 prose-blockquote:border-cyan-400/60 prose-blockquote:bg-white/[0.02] prose-blockquote:backdrop-blur-sm prose-blockquote:px-4 prose-blockquote:py-3 prose-blockquote:text-neutral-300"
        >
        <slot />
        </div>
      </div>
    </div>

    <!-- TOC Sidebar (desktop) -->
    {tocHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <div class="glass-panel sticky top-20 p-5">
          <h2 class="mb-4 font-mono text-xs font-semibold tracking-wider text-neutral-400">Quick Nav</h2>
          <ul class="space-y-1 font-mono text-[13px]">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-3" : ""}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug} class="toc-link text-neutral-400 hover:text-cyan-300">
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </article>

  <!-- TOC scroll-spy -->
  <script is:inline>
    (function () {
      const links = Array.from(document.querySelectorAll("[data-toc-link]"));
      const sections = links
        .map(function (link) { return document.getElementById(link.getAttribute("data-toc-link") ?? ""); })
        .filter(Boolean);

      if (links.length > 0 && sections.length > 0) {
        var activate = function (id) {
          links.forEach(function (link) {
            var active = link.getAttribute("data-toc-link") === id;
            link.classList.toggle("toc-active", active);
            link.classList.toggle("text-cyan-300", active);
            link.classList.toggle("font-medium", active);
            link.classList.toggle("text-neutral-400", !active);
          });
        };

        var observer = new IntersectionObserver(
          function (entries) {
            var visible = entries
              .filter(function (entry) { return entry.isIntersecting; })
              .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; })[0];
            if (visible && visible.target && visible.target.id) activate(visible.target.id);
          },
          { rootMargin: "-20% 0px -70% 0px", threshold: 0.1 }
        );

        sections.forEach(function (section) { observer.observe(section); });
        activate(sections[0].id);
      }
    })();
  </script>

  <!-- Related Posts (simple terminal-style list) -->
  {relatedPosts.length > 0 && (
    <section class="mt-12 border-t-2 border-white/[0.06] pt-8">
      <p class="mb-4 font-mono text-xs tracking-wider text-neutral-500">
        <span class="text-cyan-400">$</span> ls ./related/
      </p>
      <ul class="space-y-2">
        {relatedPosts.slice(0, 4).map((post: any) => (
          <li>
            <a
              href={withBase(`/${collectionType}/${post.id}/`)}
              class="group flex items-center gap-3 rounded-sm px-3 py-2 font-mono text-sm text-neutral-300 hover:bg-white/[0.04] hover:text-cyan-300 border-2 border-transparent hover:border-white/[0.1] transition-all duration-100"
            >
              <span class="text-neutral-600 group-hover:text-cyan-400">▸</span>
              <span class="truncate">{post.data.title}</span>
              <span class="ml-auto flex-shrink-0 text-[10px] text-neutral-600">
                {post.data.platform || post.data.date?.toLocaleDateString("en-CA") || ""}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
