---
// BaseLayout – root layout shell for every page.
// Composes: ViewTransitions, CSP, font preloads, nav, footer, and
// interactive islands (ThemeToggle, Terminal, CopyButton, ImageLightbox).
import "../styles/global.css";
import { getPublishedBlogPosts, getPublishedCtfPosts, getTagCounts } from "../lib/content";
import { withBase } from "../utils";
import ThemeToggle from "../components/ThemeToggle.astro";
import Terminal from "../components/Terminal.astro";
import CursorTrail from "../components/CursorTrail.astro";
import CopyButton from "../components/CopyButton.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import CommandPalette from "../components/CommandPalette.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kyrux cybersecurity research blog" } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://kyrux29.github.io");
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteUrl).toString();
const ogImageUrl = new URL(
  `${withBase("/og.svg")}?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description)}`,
  siteUrl
).toString();

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/ctf/"), label: "CTF" },
  { href: withBase("/blog/"), label: "Blog" },
  { href: withBase("/tags/"), label: "Tags" },
  { href: withBase("/about/"), label: "About" },
];

const blogEntries = await getPublishedBlogPosts();
const ctfEntries = await getPublishedCtfPosts();

const terminalItems = {
  blog: blogEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: entry.data.description ?? "Technical research notes",
    url: withBase(`/blog/${entry.id}/`),
  })),
  ctf: ctfEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: `${entry.data.platform}${entry.data.vulnerability_type ? ` | ${entry.data.vulnerability_type}` : ""}`,
    url: withBase(`/ctf/${entry.id}/`),
  })),
};

const tagCounts = await getTagCounts();
const terminalStats = { ctf: ctfEntries.length, blog: blogEntries.length, tags: tagCounts.length };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- CSP baseline: self-origin + data URIs for inline images. Astro hash will be injected automatically. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' https:;"
    />

    <!-- Font preloads for better LCP -->
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Pixel font for Minecraft accent (logo, headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Kyrux Labs RSS" href={withBase("/rss.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Kyrux Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

  </head>
  <body class="min-h-screen relative">
    <!-- Ambient mesh background (glassmorphism foundation) -->
    <div class="ambient-mesh" aria-hidden="true"></div>

    <!-- Skip-to-content -->
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-neutral-900 focus:px-3 focus:py-2 focus:text-cyan-300">
      Skip to content
    </a>

    <!-- Reading progress bar (XP bar style) -->
    <canvas id="xp-bar" class="fixed left-0 top-0 z-50 h-[6px] w-full" style="image-rendering: pixelated;"></canvas>

    <!-- Sticky header -->
    <header id="site-header" class="sticky top-0 z-40 w-full border-b border-transparent transition-all duration-300">
      <div class="absolute inset-0 bg-neutral-950/70 backdrop-blur-2xl"></div>
      <div class="relative mx-auto flex max-w-5xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a
          href={withBase("/")}
          class="shrink-0 text-sm font-semibold tracking-tight text-neutral-100 hover:text-cyan-300 transition-colors"
          style="font-family: var(--font-pixel);"
        >
          kyrux<span class="text-cyan-400">.</span>
        </a>
        <nav aria-label="Main Navigation" class="min-w-0 flex-1">
          <ul class="flex min-w-0 items-center gap-1 overflow-x-auto whitespace-nowrap text-sm [scrollbar-width:none]">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "relative rounded-sm px-3 py-1.5 text-neutral-400 hover:text-cyan-300 hover:bg-white/[0.04] transition-all duration-100",
                      currentPath === new URL(link.href, Astro.url).pathname
                        ? "text-cyan-300 bg-white/[0.04] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:w-4 after:rounded-sm after:bg-cyan-400"
                        : ""
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="ml-auto flex shrink-0 items-center gap-1.5">
          <ThemeToggle />
          <button id="terminal-toggle" type="button" class="inline-flex items-center gap-1.5 rounded-sm border-2 border-white/[0.08] bg-white/[0.03] px-2.5 py-1.5 font-mono text-xs text-neutral-400 hover:border-white/[0.2] hover:text-cyan-300 hover:bg-white/[0.06] backdrop-blur-sm transition-all duration-100" title="Open terminal (Ctrl+`)">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            <span class="hidden sm:inline">terminal</span>
          </button>
        </div>
      </div>
    </header>

    <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-5xl flex-col px-4 py-5 sm:px-6 lg:px-8">

      <main id="content" class="flex-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-white/[0.06] pt-6 pb-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-500">
          <p>&copy; {new Date().getFullYear()} Kyrux &mdash; Vu Trong Quoc Khanh.</p>
          <div class="flex items-center gap-4">
            <a href="https://github.com/kyrux29" target="_blank" rel="noreferrer" class="text-neutral-500 hover:text-cyan-400 transition-colors duration-100">GitHub</a>
            <a href={withBase("/rss.xml")} class="text-neutral-500 hover:text-cyan-400 transition-colors duration-100">RSS</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Interactive islands (bare Astro components – scripts auto-bundled by Astro) -->
    <CopyButton />
    <ImageLightbox />
    <CursorTrail />
    <Terminal />
    <CommandPalette />
    <BackToTop />

    <!-- Cmd+K hint -->
    <div id="cmdk-hint" class="fixed bottom-6 left-6 z-40 hidden items-center gap-2 rounded-sm border-2 border-white/[0.06] bg-neutral-900/70 backdrop-blur-xl px-3 py-2 text-xs text-neutral-500 lg:flex" style="font-family: var(--font-mono);">
      <kbd class="rounded-sm border-2 border-white/[0.1] bg-white/[0.05] px-1.5 py-0.5 text-neutral-300">Cmd+K</kbd>
      <span>Search</span>
    </div>

    <!-- Terminal data payload (read by Terminal island) -->
    <script is:inline id="terminal-data" type="application/json" set:html={JSON.stringify(terminalItems)}></script>

    <script is:inline id="terminal-stats" type="application/json" set:html={JSON.stringify(terminalStats)}></script>

    <!-- XP bar progress script -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById("xp-bar");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const SEG_W = 6; // pixel width of each XP segment
        const GAP = 1;   // gap between segments
        const BAR_H = 6;
        const COLOR_FILL = "#22d3ee";   // cyan-400
        const COLOR_EMPTY = "rgba(38,38,38,0.5)";

        const resize = () => {
          canvas.width = window.innerWidth;
          canvas.height = BAR_H;
        };
        resize();
        window.addEventListener("resize", resize);

        const draw = () => {
          const scrollTop = window.scrollY;
          const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = scrollHeight > 0 ? Math.min(1, scrollTop / scrollHeight) : 0;
          const totalSegs = Math.floor(canvas.width / (SEG_W + GAP));
          const filledSegs = Math.round(totalSegs * progress);

          ctx.clearRect(0, 0, canvas.width, canvas.height);
          for (let i = 0; i < totalSegs; i++) {
            ctx.fillStyle = i < filledSegs ? COLOR_FILL : COLOR_EMPTY;
            ctx.fillRect(i * (SEG_W + GAP), 0, SEG_W, BAR_H);
          }
        };
        window.addEventListener("scroll", draw, { passive: true });
        draw();
      })();
    </script>

    <!-- Easter eggs: konami code + terminal toggle (Ctrl+`) -->
    <script is:inline>
      (function() {
        // Konami code: ↑↑↓↓←→←→BA
        const konami = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
        let pos = 0;

        document.addEventListener("keydown", function(e) {
          if (e.key === konami[pos]) {
            pos++;
            if (pos === konami.length) {
              document.body.style.transition = "filter 0.15s";
              document.body.style.filter = "hue-rotate(180deg)";
              setTimeout(function() {
                document.body.style.filter = "";
                setTimeout(function() {
                  document.body.style.transition = "";
                }, 150);
              }, 200);
              console.log("%c🛡️ Kyrux Labs %c— If you know the enemy and know yourself, you need not fear the result of a hundred battles.",
                "color: #06b6d4; font-size: 16px; font-weight: bold;",
                "color: #a3a3a3;");
              pos = 0;
            }
          } else {
            pos = 0;
          }

          // Ctrl + ` (grave accent) to toggle terminal - uses exposed terminalAPI
          if (e.ctrlKey && e.key === "`") {
            e.preventDefault();
            const api = window.terminalAPI;
            if (api && typeof api.open === "function") {
              const modal = document.getElementById("terminal-modal");
              if (modal && modal.classList.contains("flex")) {
                api.close();
              } else if (api.open) {
                api.open();
              }
            } else {
              // Fallback if API not ready
              console.warn("[Terminal] API not initialized yet");
              const modal = document.getElementById("terminal-modal");
              if (modal) {
                if (modal.classList.contains("flex")) {
                  modal.classList.add("hidden");
                  modal.classList.remove("flex");
                } else {
                  modal.classList.remove("hidden");
                  modal.classList.add("flex");
                  const input = document.getElementById("terminal-input");
                  if (input) input.focus();
                }
              }
            }
          }
        });
      })();
    </script>

    <!-- Navbar scroll shadow -->
    <script is:inline>
      (function() {
        var header = document.getElementById("site-header");
        if (!header) return;
        window.addEventListener("scroll", function() {
          var scrolled = window.scrollY > 8;
          header.style.borderBottomColor = scrolled ? "rgba(255,255,255,0.04)" : "transparent";
        }, { passive: true });
      })();
    </script>

    <!-- Restore cursor trail state from localStorage -->
    <script is:inline>
      (function() {
        // Cursor trail (delay until API is ready)
        if (localStorage.getItem("cursor-trail-enabled") === "true") {
          var check = setInterval(function() {
            if (window.cursorTrailAPI && window.cursorTrailAPI.start) {
              window.cursorTrailAPI.start();
              clearInterval(check);
            }
          }, 100);
          // Timeout after 5 seconds
          setTimeout(function() { clearInterval(check); }, 5000);
        }
      })();
    </script>

    <!-- Scroll-reveal observer -->
    <script is:inline>
      (function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("reveal-active");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -30px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
        // Observe dynamically added .reveal elements
        new MutationObserver(() => {
          document.querySelectorAll(".reveal:not(.reveal-active)").forEach((el) => observer.observe(el));
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <!-- Click particle (block-break) effect -->
    <script is:inline>
      (function () {
        var PARTICLE_COUNT = 4;
        var LIFETIME = 350;
        document.addEventListener("click", function (e) {
          for (var i = 0; i < PARTICLE_COUNT; i++) {
            var el = document.createElement("div");
            var size = 3 + Math.floor(Math.random() * 4); // 3-6px
            el.style.cssText =
              "position:fixed;z-index:9999;pointer-events:none;" +
              "width:" + size + "px;height:" + size + "px;" +
              "background:#22d3ee;" + // cyan-400
              "left:" + e.clientX + "px;top:" + e.clientY + "px;" +
              "opacity:1;transition:none;";
            document.body.appendChild(el);

            var angle = (Math.PI * 2 * i) / PARTICLE_COUNT + (Math.random() - 0.5);
            var dist = 18 + Math.random() * 22;
            var tx = Math.cos(angle) * dist;
            var ty = Math.sin(angle) * dist + 10; // slight gravity pull

            // Force reflow then animate
            el.getBoundingClientRect();
            el.style.transition = "transform " + LIFETIME + "ms ease-out, opacity " + LIFETIME + "ms ease-out";
            el.style.transform = "translate(" + tx + "px," + ty + "px) rotate(" + (Math.random() * 90) + "deg)";
            el.style.opacity = "0";

            setTimeout(function (node) {
              node.remove();
            }, LIFETIME + 50, el);
          }
        });
      })();
    </script>
  </body>
</html>
