---
// BaseLayout – root layout shell for every page.
// Composes: ViewTransitions, CSP, font preloads, nav, footer, and
// interactive islands (ThemeToggle, Terminal, CopyButton, ImageLightbox).
import "../styles/global.css";
import { getPublishedBlogPosts, getPublishedCtfPosts } from "../lib/content";
import { withBase } from "../utils";
import ThemeToggle from "../components/ThemeToggle.astro";
import Terminal from "../components/Terminal.astro";
import CopyButton from "../components/CopyButton.astro";
import ImageLightbox from "../components/ImageLightbox.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kyrux cybersecurity research blog" } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://kyrux29.github.io");
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteUrl).toString();
const ogImageUrl = new URL(
  `${withBase("/og.svg")}?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description)}`,
  siteUrl
).toString();

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/ctf/"), label: "CTF" },
  { href: withBase("/blog/"), label: "Blog" },
  { href: withBase("/tags/"), label: "Tags" },
  { href: withBase("/search/"), label: "Search" },
  { href: withBase("/about/"), label: "About" },
  { href: "https://github.com/kyrux29", label: "GitHub", external: true },
];

const blogEntries = await getPublishedBlogPosts();
const ctfEntries = await getPublishedCtfPosts();

const terminalItems = {
  blog: blogEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: entry.data.description ?? "Technical research notes",
    url: withBase(`/blog/${entry.id}/`),
  })),
  ctf: ctfEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: `${entry.data.platform}${entry.data.vulnerability_type ? ` | ${entry.data.vulnerability_type}` : ""}`,
    url: withBase(`/ctf/${entry.id}/`),
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- CSP baseline: self-origin + data URIs for inline images. Astro hash will be injected automatically. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' https:;"
    />

    <!-- Font preloads for better LCP -->
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Kyrux Labs RSS" href={withBase("/rss.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Kyrux Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

  </head>
  <body class="min-h-screen">
    <!-- Skip-to-content -->
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-slate-900 focus:px-3 focus:py-2 focus:text-cyan-300">
      Skip to content
    </a>

    <!-- Reading progress bar (tiny inline script – kept here for performance) -->
    <div id="reading-progress" class="fixed left-0 top-0 z-50 h-0.5 w-0 bg-cyan-400/90"></div>

    <div class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-4 py-5 sm:px-6 lg:px-8">
      <header class="mb-8 sm:mb-10">
        <div class="panel mx-auto flex max-w-4xl flex-wrap items-center gap-3 px-4 py-2">
          <a
            href={withBase("/")}
            class="rounded-full border border-slate-700 bg-slate-950 px-4 py-1.5 text-sm font-semibold tracking-wider text-slate-100"
          >
            KYRUX_LABS
          </a>
          <nav aria-label="Main Navigation" class="min-w-0 flex-1">
            <ul class="flex min-w-0 items-center gap-4 overflow-x-auto whitespace-nowrap text-xs [scrollbar-width:none] sm:gap-7 sm:text-sm">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noreferrer" : undefined}
                      class:list={[
                        "rounded-md px-2 py-1 text-slate-400 hover:text-cyan-300",
                        !link.external && currentPath === new URL(link.href, Astro.url).pathname ? "bg-slate-950/60 text-cyan-300" : ""
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="ml-auto flex items-center gap-2">
            <ThemeToggle />
            <button id="terminal-toggle" type="button" class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1.5 text-xs text-slate-300 hover:border-cyan-500 hover:text-cyan-300">
              Terminal
            </button>
          </div>
        </div>
      </header>

      <main id="content" class="flex-1">
        <slot />
      </main>

      <footer class="mt-14 border-t border-slate-800 pt-6 text-sm text-slate-500">
        <p>&copy; {new Date().getFullYear()} Kyrux | Vu Trong Quoc Khanh.</p>
      </footer>
    </div>

    <!-- Interactive islands (bare Astro components – scripts auto-bundled by Astro) -->
    <CopyButton />
    <ImageLightbox />
    <Terminal />

    <!-- Terminal data payload (read by Terminal island) -->
    <script is:inline id="terminal-data" type="application/json" set:html={JSON.stringify(terminalItems)}></script>

    <!-- Reading progress bar script (tiny, kept inline for zero-overhead) -->
    <script is:inline>
      const progressBar = document.getElementById("reading-progress");
      const updateProgress = () => {
        if (!progressBar) return;
        const scrollTop = window.scrollY;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollHeight > 0 ? Math.min(100, (scrollTop / scrollHeight) * 100) : 0;
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    </script>
  </body>
</html>
