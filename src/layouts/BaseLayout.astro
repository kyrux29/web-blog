---
// BaseLayout – root layout shell for every page.
// Composes: ViewTransitions, CSP, nav, footer, and
// interactive islands (ThemeToggle, Terminal, CopyButton, ImageLightbox).
import "../styles/global.css";
import { getPublishedBlogPosts, getPublishedCtfPosts, getTagCounts } from "../lib/content";
import { withBase } from "../utils";
import ThemeToggle from "../components/ThemeToggle.astro";
import SoundToggle from "../components/SoundToggle.astro";
import SoundController from "../components/SoundController.astro";
import Terminal from "../components/Terminal.astro";
import CursorTrail from "../components/CursorTrail.astro";
import CopyButton from "../components/CopyButton.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import CommandPalette from "../components/CommandPalette.astro";
import BackToTop from "../components/BackToTop.astro";
import { siteRoutes } from "../config/site-routes";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kyrux cybersecurity research blog" } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://kyrux.xyz");
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteUrl).toString();
const ogImageUrl = new URL(
  `${withBase("/og.svg")}?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description)}`,
  siteUrl
).toString();

const currentPath = Astro.url.pathname;

const navLinks = siteRoutes.map((route) => ({ ...route, href: withBase(route.path) }));

const isNavActive = (href: string) => {
  const pathname = new URL(href, Astro.url).pathname;
  return pathname === withBase("/")
    ? currentPath === pathname
    : currentPath.startsWith(pathname);
};

const activeNav = navLinks.find((link) => isNavActive(link.href)) ?? navLinks[0];
const isHome = currentPath === withBase("/");

const blogEntries = await getPublishedBlogPosts();
const ctfEntries = await getPublishedCtfPosts();

const terminalItems = {
  blog: blogEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: entry.data.description ?? "Technical research notes",
    url: withBase(`/blog/${entry.id}/`),
  })),
  ctf: ctfEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: `${entry.data.platform}${entry.data.vulnerability_type ? ` | ${entry.data.vulnerability_type}` : ""}`,
    url: withBase(`/ctf/${entry.id}/`),
  })),
};

const tagCounts = await getTagCounts();
const terminalStats = { ctf: ctfEntries.length, blog: blogEntries.length, tags: tagCounts.length };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d090b" />

    <!-- CSP baseline: self-origin + data URIs for inline images. Astro hash will be injected automatically. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-src 'self' https:;"
    />
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = window.localStorage.getItem("kyrux-theme-v2");
        } catch (_) {}
        var theme = saved === "light" ? "light" : "dim";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme === "dim" ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dim" ? "#0d090b" : "#f1eeeb",
        );
      })();
    </script>

    <!-- Editorial display + readable body + technical utility type -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Unbounded:wght@600;700;800&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Kyrux Labs RSS" href={withBase("/rss.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Kyrux Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

  </head>
  <body class="site-body min-h-screen relative" data-page-kind={isHome ? "home" : "inner"}>
    <!-- Field-note paper, registration marks, and the diagonal signal ribbon -->
    <div class="ambient-mesh" aria-hidden="true"></div>

    {
      !isHome && (
        <div class="inner-bat-field" aria-hidden="true">
          <div class="inner-bat-drift">
            {[0, 1, 2].map(() => (
              <svg viewBox="0 0 64 32" role="presentation" focusable="false">
                <path d="M32 14C27 8 21 5 13 5c3 3 4 6 3 10-4-3-8-3-12-1 5 3 8 7 10 13 6-2 11-5 18-9 7 4 12 7 18 9 2-6 5-10 10-13-4-2-8-2-12 1-1-4 0-7 3-10-8 0-14 3-19 9Z" />
              </svg>
            ))}
          </div>
        </div>
      )
    }

    <!-- Batwing Door: wings close over the document, then a Dracula gate opens onto the next route. -->
    <div id="route-transition" class="route-transition" data-state="idle" aria-hidden="true">
      <div class="route-transition-night"></div>
      <div class="route-transition-flock">
        {
          Array.from({ length: 6 }).map(() => (
            <svg viewBox="0 0 64 32" role="presentation" focusable="false">
              <path d="M32 14C27 8 21 5 13 5c3 3 4 6 3 10-4-3-8-3-12-1 5 3 8 7 10 13 6-2 11-5 18-9 7 4 12 7 18 9 2-6 5-10 10-13-4-2-8-2-12 1-1-4 0-7 3-10-8 0-14 3-19 9Z" />
            </svg>
          ))
        }
      </div>
      <svg class="route-transition-wing route-transition-wing--left" viewBox="0 0 520 420" preserveAspectRatio="none" role="presentation">
        <path d="M515 166C420 74 278 27 18 48c88 62 122 142 117 262q30-70 60 25q38-80 76 15q48-90 96-16q86-67 148-24V166Z" />
      </svg>
      <svg class="route-transition-wing route-transition-wing--right" viewBox="0 0 520 420" preserveAspectRatio="none" role="presentation">
        <path d="M515 166C420 74 278 27 18 48c88 62 122 142 117 262q30-70 60 25q38-80 76 15q48-90 96-16q86-67 148-24V166Z" />
      </svg>
      <div class="route-transition-doorway">
        <div class="route-transition-door-frame">
          <div class="route-transition-door-glow"></div>
          <div class="route-transition-door route-transition-door--left"><i></i></div>
          <div class="route-transition-door route-transition-door--right"><i></i></div>
          <span class="route-transition-door-mark">K</span>
        </div>
      </div>
      <p class="route-transition-label">
        <strong id="route-transition-target">{activeNav.label}</strong>
      </p>
    </div>
    <script is:inline>
      (function () {
        try {
          if (window.sessionStorage.getItem("kyrux-route-entry") !== "1") return;
          window.sessionStorage.removeItem("kyrux-route-entry");
          var gate = document.getElementById("route-transition");
          if (gate) gate.dataset.state = "entering";
        } catch (_) {}
      })();
    </script>

    <!-- Skip-to-content -->
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-neutral-900 focus:px-3 focus:py-2 focus:text-rose-300">
      Skip to content
    </a>

    <!-- Segmented reading progress bar -->
    <canvas id="xp-bar" aria-hidden="true" class="fixed left-0 top-0 z-50 h-[6px] w-full" style="image-rendering: pixelated;"></canvas>

    <!-- Sticky header -->
    <header id="site-header" class="site-header sticky top-0 z-40 w-full" data-page={isHome ? "home" : "inner"}>
      <div class="nav-deck-wrap mx-auto px-3 sm:px-6 lg:px-8">
        <div class="nav-deck">
          <a href={withBase("/")} class="site-logo" aria-label="KYRUX Blog home" translate="no">
            <span class="site-logo-mark" aria-hidden="true">KYRUX</span>
          </a>

          <div class="nav-tools">
            <button id="search-toggle" type="button" class="nav-tool" aria-label="Open search" title="Open search (Ctrl+K)">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            </button>
            <ThemeToggle />
            <SoundToggle />
            <button
              id="terminal-toggle"
              type="button"
              class="nav-tool"
              title="Open terminal (Ctrl+`)"
              aria-label="Open terminal"
              aria-expanded="false"
            >
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            </button>
          </div>

          <button
            id="nav-menu-toggle"
            class="nav-menu-toggle"
            type="button"
            aria-controls="site-navigation"
            aria-expanded="false"
            aria-label="Open site index"
          >
            <span class="nav-menu-copy">
              <strong class="nav-menu-open-label">Menu</strong>
              <strong class="nav-menu-close-label">Close</strong>
            </span>
            <span class="nav-menu-glyph" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>

        <nav id="site-navigation" class="site-navigation" aria-label="Site index" data-open="false" aria-hidden="true" inert>
          <div class="nav-index-shell">
            <ul class="nav-route-list">
              {
                navLinks.map((link) => {
                  const active = isNavActive(link.href);
                  return (
                    <li>
                      <a href={link.href} class:list={["nav-route-link", active && "active"]} aria-current={active ? "page" : undefined} data-route-title={link.label}>
                        {link.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
            <div class="nav-sound-control">
              <SoundToggle variant="menu" />
            </div>
          </div>
        </nav>
      </div>
    </header>

    <div class="site-shell relative z-10 mx-auto flex min-h-screen w-full max-w-6xl flex-col px-4 py-5 sm:px-6 lg:px-8">

      <main id="content" class:list={["flex-1", !isHome && "inner-main"]}>
        <slot />
      </main>

      <footer class="site-footer mt-16 pt-6 pb-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-500">
          <p><span class="footer-prompt">END_OF_FILE</span> &copy; {new Date().getFullYear()} Kyrux &mdash; Vu Trong Quoc Khanh.</p>
          <div class="flex items-center gap-4">
            <a href="https://github.com/kyrux29" target="_blank" rel="noreferrer" class="text-neutral-500 hover:text-rose-400 transition-colors duration-100">GitHub</a>
            <a href={withBase("/rss.xml")} data-no-transition class="text-neutral-500 hover:text-rose-400 transition-colors duration-100">RSS</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Interactive islands (bare Astro components – scripts auto-bundled by Astro) -->
    <CopyButton />
    <ImageLightbox />
    <CursorTrail />
    <Terminal />
    <CommandPalette />
    <BackToTop />
    <SoundController />

    <!-- Terminal data payload (read by Terminal island) -->
    <script is:inline id="terminal-data" type="application/json" set:html={JSON.stringify(terminalItems)}></script>

    <script is:inline id="terminal-stats" type="application/json" set:html={JSON.stringify(terminalStats)}></script>

    <!-- Cross-page breach gate. Keeps normal document navigation so page scripts reinitialize safely. -->
    <script is:inline>
      (function () {
        var gate = document.getElementById("route-transition");
        var target = document.getElementById("route-transition-target");
        if (!gate) return;

        var motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        var settleGate = function () {
          if (gate.dataset.state === "entering") gate.dataset.state = "idle";
        };

        if (motionQuery.matches) {
          gate.dataset.state = "idle";
        } else if (gate.dataset.state === "entering") {
          window.setTimeout(settleGate, 600);
        }

        window.addEventListener("pageshow", function (event) {
          delete document.documentElement.dataset.routeLeaving;
          if (!event.persisted || motionQuery.matches) return;
          gate.dataset.state = "entering";
          window.setTimeout(settleGate, 600);
        });

        document.addEventListener("click", function (event) {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          var clicked = event.target instanceof Element ? event.target.closest("a") : null;
          if (!clicked || clicked.hasAttribute("download") || clicked.hasAttribute("data-no-transition")) return;
          if (clicked.target && clicked.target !== "_self") return;

          var url;
          try { url = new URL(clicked.href, window.location.href); } catch (_) { return; }
          if (url.origin !== window.location.origin || !/^https?:$/.test(url.protocol)) return;
          if (url.href === window.location.href) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;

          if (motionQuery.matches) return;
          event.preventDefault();
          if (gate.dataset.state === "leaving") return;

          var routeName = clicked.getAttribute("data-route-title") || url.pathname.split("/").filter(Boolean)[0] || "HOME";
          if (target) target.textContent = routeName.toUpperCase();
          try {
            window.sessionStorage.setItem("kyrux-route-entry", "1");
          } catch (_) {}
          if (window.kyruxSound && typeof window.kyruxSound.play === "function") {
            window.kyruxSound.play("route-close");
          }
          gate.dataset.state = "leaving";
          document.documentElement.dataset.routeLeaving = "true";
          window.setTimeout(function () { window.location.assign(url.href); }, 650);
        });
      })();
    </script>

    <!-- XP bar progress script -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById("xp-bar");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const SEG_W = 6; // pixel width of each XP segment
        const GAP = 1;   // gap between segments
        const BAR_H = 6;
        const COLOR_FILL = "#c7193f";
        const COLOR_EMPTY = "rgba(23,16,18,0.14)";

        const resize = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(window.innerWidth * dpr);
          canvas.height = Math.round(BAR_H * dpr);
          canvas.style.width = window.innerWidth + "px";
          canvas.style.height = BAR_H + "px";
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener("resize", function() { resize(); draw(); });

        const draw = () => {
          const scrollTop = window.scrollY;
          const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = scrollHeight > 0 ? Math.min(1, scrollTop / scrollHeight) : 0;
          const totalSegs = Math.floor(window.innerWidth / (SEG_W + GAP));
          const filledSegs = Math.round(totalSegs * progress);

          ctx.clearRect(0, 0, window.innerWidth, BAR_H);
          for (let i = 0; i < totalSegs; i++) {
            ctx.fillStyle = i < filledSegs ? COLOR_FILL : COLOR_EMPTY;
            ctx.fillRect(i * (SEG_W + GAP), 0, SEG_W, BAR_H);
          }
        };
        let frame = 0;
        window.addEventListener("scroll", function() {
          if (frame) return;
          frame = requestAnimationFrame(function() {
            draw();
            frame = 0;
          });
        }, { passive: true });
        draw();
      })();
    </script>

    <!-- Easter eggs: konami code + terminal toggle (Ctrl+`) -->
    <script is:inline>
      (function() {
        // Konami code: ↑↑↓↓←→←→BA
        const konami = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
        let pos = 0;

        document.addEventListener("keydown", function(e) {
          if (e.key === konami[pos]) {
            pos++;
            if (pos === konami.length) {
              document.body.style.transition = "filter 0.15s";
              document.body.style.filter = "hue-rotate(180deg)";
              setTimeout(function() {
                document.body.style.filter = "";
                setTimeout(function() {
                  document.body.style.transition = "";
                }, 150);
              }, 200);
              console.log("%c🛡️ Kyrux Labs %c— If you know the enemy and know yourself, you need not fear the result of a hundred battles.",
                "color: #c7193f; font-size: 16px; font-weight: bold;",
                "color: #a3a3a3;");
              pos = 0;
            }
          } else {
            pos = 0;
          }

          // Ctrl + ` (grave accent) to toggle terminal - uses exposed terminalAPI
          if (e.ctrlKey && e.key === "`") {
            e.preventDefault();
            const api = window.terminalAPI;
            if (api && typeof api.open === "function") {
              const modal = document.getElementById("terminal-modal");
              if (modal && modal.classList.contains("flex")) {
                api.close();
              } else if (api.open) {
                api.open();
              }
            } else {
              // Fallback if API not ready
              console.warn("[Terminal] API not initialized yet");
              const modal = document.getElementById("terminal-modal");
              if (modal) {
                if (modal.classList.contains("flex")) {
                  modal.classList.add("hidden");
                  modal.classList.remove("flex");
                } else {
                  modal.classList.remove("hidden");
                  modal.classList.add("flex");
                  const input = document.getElementById("terminal-input");
                  if (input) input.focus();
                }
              }
            }
          }
        });
      })();
    </script>

    <!-- Full-screen breach index + compact scrolled state -->
    <script is:inline>
      (function() {
        var header = document.getElementById("site-header");
        var toggle = document.getElementById("nav-menu-toggle");
        var navigation = document.getElementById("site-navigation");
        var siteShell = document.querySelector(".site-shell");
        var navTools = header && header.querySelector(".nav-tools");
        var siteLogo = header && header.querySelector(".site-logo");
        if (!header || !toggle || !navigation) return;

        var routeLinks = Array.from(navigation.querySelectorAll("a"));
        var menuSoundToggle = navigation.querySelector("[data-sound-toggle]");
        var previousFocus = null;
        var previousOverflow = "";

        var setOpen = function(open, restoreFocus) {
          if (restoreFocus === undefined) restoreFocus = true;
          navigation.dataset.open = String(open);
          navigation.setAttribute("aria-hidden", String(!open));
          navigation.inert = !open;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Close site index" : "Open site index");
          header.dataset.menuOpen = String(open);
          document.documentElement.classList.toggle("nav-index-open", open);
          if (siteShell) siteShell.inert = open;
          if (navTools) navTools.inert = open;
          if (siteLogo) siteLogo.inert = open;

          if (open) {
            previousFocus = document.activeElement;
            previousOverflow = document.documentElement.style.overflow;
            document.documentElement.style.overflow = "hidden";
            window.requestAnimationFrame(function () {
              var active = navigation.querySelector("a[aria-current='page']") || routeLinks[0];
              if (active) active.focus();
            });
          } else {
            document.documentElement.style.overflow = previousOverflow;
            if (restoreFocus && previousFocus && typeof previousFocus.focus === "function") previousFocus.focus();
            previousFocus = null;
          }
        };

        toggle.addEventListener("click", function() {
          var willOpen = toggle.getAttribute("aria-expanded") !== "true";
          if (window.kyruxSound && typeof window.kyruxSound.play === "function") {
            window.kyruxSound.play(willOpen ? "menu-open" : "menu-close");
          }
          setOpen(willOpen, !willOpen);
        });

        routeLinks.forEach(function(link) {
          link.addEventListener("click", function() { setOpen(false, false); });
        });

        document.addEventListener("keydown", function(event) {
          var open = toggle.getAttribute("aria-expanded") === "true";
          if (!open) return;

          if (event.key === "Escape") {
            event.preventDefault();
            if (window.kyruxSound && typeof window.kyruxSound.play === "function") {
              window.kyruxSound.play("menu-close");
            }
            setOpen(false);
            toggle.focus();
            return;
          }

          if (event.key === "ArrowDown" || event.key === "ArrowUp" || event.key === "Home" || event.key === "End") {
            event.preventDefault();
            var current = routeLinks.indexOf(document.activeElement);
            if (current < 0 && event.key === "ArrowUp") current = 0;
            var next = current;
            if (event.key === "Home") next = 0;
            else if (event.key === "End") next = routeLinks.length - 1;
            else if (event.key === "ArrowDown") next = (current + 1 + routeLinks.length) % routeLinks.length;
            else next = (current - 1 + routeLinks.length) % routeLinks.length;
            routeLinks[next] && routeLinks[next].focus();
            return;
          }

          if (event.key === "Tab") {
            var focusables = [toggle].concat(routeLinks);
            if (menuSoundToggle && menuSoundToggle.offsetParent !== null) {
              focusables.push(menuSoundToggle);
            }
            var first = focusables[0];
            var last = focusables[focusables.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        navigation.addEventListener("pointerdown", function(event) {
          if (event.target !== navigation) return;
          if (window.kyruxSound && typeof window.kyruxSound.play === "function") {
            window.kyruxSound.play("menu-close");
          }
          setOpen(false);
        });

        window.addEventListener("scroll", function() {
          header.dataset.scrolled = String(window.scrollY > 12);
        }, { passive: true });
      })();
    </script>

    <!-- Restore cursor trail state from localStorage -->
    <script is:inline>
      (function() {
        // Cursor trail (delay until API is ready)
        if (
          localStorage.getItem("cursor-trail-enabled") === "true" &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          var check = setInterval(function() {
            if (window.cursorTrailAPI && window.cursorTrailAPI.start) {
              window.cursorTrailAPI.start();
              clearInterval(check);
            }
          }, 100);
          // Timeout after 5 seconds
          setTimeout(function() { clearInterval(check); }, 5000);
        }
      })();
    </script>

    <!-- Scroll-reveal observer -->
    <script is:inline>
      (function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("reveal-active");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -30px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      })();
    </script>

    <!-- Kinetic Dracula: cut-letter type, staggered dossiers, and restrained pointer parallax. -->
    <script is:inline>
      (function () {
        var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        var hash = function (value) {
          var output = 9;
          for (var index = 0; index < value.length; index += 1) {
            output = Math.imul(output ^ value.charCodeAt(index), 387420489);
          }
          return (output ^ (output >>> 9)) >>> 0;
        };

        var decorateType = function (target, hiddenGroup) {
          if (!target || target.dataset.kineticType === "ready") return;
          var label = (target.textContent || "").replace(/\s+/g, " ").trim();
          if (!label) return;

          target.textContent = "";
          target.dataset.kineticType = "ready";
          target.classList.add("kinetic-type");
          if (hiddenGroup) target.setAttribute("aria-hidden", "true");
          else target.setAttribute("aria-label", label);

          var glyphIndex = 0;
          var plateCount = 0;
          var signalCount = 0;
          label.split(" ").forEach(function (word, wordIndex, words) {
            var wordNode = document.createElement("span");
            wordNode.className = "kinetic-word";
            wordNode.setAttribute("aria-hidden", "true");

            Array.from(word).forEach(function (character) {
              var glyph = document.createElement("span");
              var glyphHash = hash(label + ":" + glyphIndex);
              var angle = ((glyphHash % 9) - 4) * 0.35;
              var vertical = ((glyphHash >>> 4) % 3) - 1;
              var variant = (glyphHash >>> 7) % 13;

              glyph.className = "kinetic-char";
              glyph.textContent = character;
              glyph.style.setProperty("--glyph-angle", angle.toFixed(2) + "deg");
              glyph.style.setProperty("--glyph-y", vertical + "px");
              glyph.style.setProperty("--glyph-order", String(glyphIndex % 10));

              if (variant === 0 && plateCount < 2) {
                glyph.classList.add("kinetic-char--plate");
                plateCount += 1;
              } else if (variant === 1 && signalCount < 2) {
                glyph.classList.add("kinetic-char--signal");
                signalCount += 1;
              }

              wordNode.appendChild(glyph);
              glyphIndex += 1;
            });

            target.appendChild(wordNode);
            if (wordIndex < words.length - 1) target.appendChild(document.createTextNode(" "));
          });

          target.addEventListener(
            "pointerenter",
            function () {
              target.querySelectorAll(".kinetic-char").forEach(function (glyph) {
                glyph.classList.add("kinetic-char--settled");
              });
            },
            { once: true },
          );
        };

        var homeTitle = document.querySelector(".codex-title");
        if (homeTitle) {
          var titleParts = Array.from(homeTitle.querySelectorAll(":scope > span, :scope > em"));
          homeTitle.setAttribute(
            "aria-label",
            titleParts.map(function (part) { return (part.textContent || "").trim(); }).join(" "),
          );
          titleParts.forEach(function (part) { decorateType(part, true); });
        }

        document.querySelectorAll(".home-route-link").forEach(function (link) {
          decorateType(link, false);
        });

        document
          .querySelectorAll(
            ".inner-page-hero h1, .about-identity .hero-title, article > .min-w-0 > header:first-child h1",
          )
          .forEach(function (title) { decorateType(title, false); });

        var motionPanels = Array.from(
          new Set(
            document.querySelectorAll(
              // Never hide the full reading surface: a long article can be taller
              // than the viewport's intersection threshold and remain transparent.
              ".archive-series, .inner-main .glass-panel",
            ),
          ),
        );
        var panelObserver = null;

        var settlePanel = function (panel) {
          panel.classList.remove("kinetic-pending", "kinetic-in");
          panel.style.removeProperty("--reveal-order");
          panel.style.removeProperty("--entry-tilt");
          if (panelObserver) panelObserver.unobserve(panel);
        };

        var settleAllPanels = function () {
          if (panelObserver) {
            panelObserver.disconnect();
            panelObserver = null;
          }
          motionPanels.forEach(settlePanel);
        };

        var startPanelReveal = function () {
          if (reducedMotion.matches || !("IntersectionObserver" in window)) {
            settleAllPanels();
            return;
          }

          motionPanels.forEach(function (panel, index) {
            panel.classList.add("kinetic-pending");
            panel.style.setProperty("--reveal-order", String(index % 6));
            panel.style.setProperty("--entry-tilt", index % 2 ? "0.55deg" : "-0.55deg");
          });

          panelObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) entry.target.classList.add("kinetic-in");
              });
            },
            { threshold: 0.08, rootMargin: "0px 0px -20px 0px" },
          );
          motionPanels.forEach(function (panel) { panelObserver.observe(panel); });
        };

        document.addEventListener("animationend", function (event) {
          if (
            event.animationName === "kyrux-glyph-arrive" &&
            event.target instanceof Element
          ) {
            event.target.classList.add("kinetic-char--settled");
          }
          if (
            event.animationName === "kyrux-panel-arrive" ||
            event.animationName === "kyrux-panel-arrive-mobile"
          ) {
            settlePanel(event.target);
          }
        });

        document.addEventListener("focusin", function (event) {
          var panel = event.target instanceof Element
            ? event.target.closest(".kinetic-pending")
            : null;
          if (panel) settlePanel(panel);
        });

        reducedMotion.addEventListener("change", function (event) {
          if (event.matches) settleAllPanels();
        });
        startPanelReveal();
      })();

      (function () {
        var finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
        var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        var scene = document.querySelector(
          "body[data-page-kind='home'] .codex-hero, body[data-page-kind='inner'] .inner-main",
        );
        if (!scene) return;

        var frame = 0;
        var rect = null;
        var attached = false;
        var nextX = 0;
        var nextY = 0;

        var navigation = document.getElementById("site-navigation");
        var gate = document.getElementById("route-transition");

        var blocked = function () {
          return (
            document.hidden ||
            (navigation && navigation.dataset.open === "true") ||
            (gate && gate.dataset.state !== "idle")
          );
        };

        var writePosition = function () {
          frame = 0;
          document.documentElement.style.setProperty("--scene-x", nextX.toFixed(2) + "px");
          document.documentElement.style.setProperty("--scene-y", nextY.toFixed(2) + "px");
          document.documentElement.style.setProperty("--scene-x-reverse", (-nextX * 0.72).toFixed(2) + "px");
          document.documentElement.style.setProperty("--scene-y-reverse", (-nextY * 0.72).toFixed(2) + "px");
        };

        var queuePosition = function () {
          if (!frame) frame = window.requestAnimationFrame(writePosition);
        };

        var reset = function () {
          nextX = 0;
          nextY = 0;
          document.body.classList.remove("scene-parallax-active");
          queuePosition();
        };

        var onPointerMove = function (event) {
          if (blocked()) {
            reset();
            return;
          }
          if (!rect) rect = scene.getBoundingClientRect();
          var horizontal = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
          var vertical = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height) * 2 - 1));
          nextX = horizontal * 8;
          nextY = vertical * 6;
          document.body.classList.add("scene-parallax-active");
          queuePosition();
        };

        var onResize = function () {
          rect = null;
          reset();
        };

        var attach = function () {
          if (attached || !finePointer.matches || reducedMotion.matches) return;
          scene.addEventListener("pointermove", onPointerMove, { passive: true });
          scene.addEventListener("pointerleave", reset, { passive: true });
          window.addEventListener("resize", onResize, { passive: true });
          window.addEventListener("blur", reset);
          attached = true;
        };

        var detach = function () {
          if (!attached) return;
          scene.removeEventListener("pointermove", onPointerMove);
          scene.removeEventListener("pointerleave", reset);
          window.removeEventListener("resize", onResize);
          window.removeEventListener("blur", reset);
          attached = false;
          rect = null;
          reset();
        };

        var reconcile = function () {
          if (finePointer.matches && !reducedMotion.matches) attach();
          else detach();
        };

        finePointer.addEventListener("change", reconcile);
        reducedMotion.addEventListener("change", reconcile);
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) reset();
        });
        window.addEventListener("pagehide", detach);
        window.addEventListener("pageshow", reconcile);

        if (navigation) {
          new MutationObserver(function () {
            if (navigation.dataset.open === "true") reset();
          }).observe(navigation, { attributes: true, attributeFilter: ["data-open"] });
        }
        if (gate) {
          new MutationObserver(function () {
            if (gate.dataset.state !== "idle") reset();
          }).observe(gate, { attributes: true, attributeFilter: ["data-state"] });
        }

        reconcile();
      })();
    </script>
  </body>
</html>
