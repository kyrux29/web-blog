---
// BaseLayout – root layout shell for every page.
// Composes: ViewTransitions, CSP, font preloads, nav, footer, and
// interactive islands (ThemeToggle, Terminal, CopyButton, ImageLightbox).
import "../styles/global.css";
import { getPublishedBlogPosts, getPublishedCtfPosts, getTagCounts } from "../lib/content";
import { withBase } from "../utils";
import ThemeToggle from "../components/ThemeToggle.astro";
import Terminal from "../components/Terminal.astro";
import CopyButton from "../components/CopyButton.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import CommandPalette from "../components/CommandPalette.astro";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Kyrux cybersecurity research blog" } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://kyrux29.github.io");
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, siteUrl).toString();
const ogImageUrl = new URL(
  `${withBase("/og.svg")}?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description)}`,
  siteUrl
).toString();

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/ctf/"), label: "CTF" },
  { href: withBase("/blog/"), label: "Blog" },
  { href: withBase("/tags/"), label: "Tags" },
  { href: withBase("/search/"), label: "Search" },
  { href: withBase("/about/"), label: "About" },
  { href: "https://github.com/kyrux29", label: "GitHub", external: true },
];

const blogEntries = await getPublishedBlogPosts();
const ctfEntries = await getPublishedCtfPosts();

const terminalItems = {
  blog: blogEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: entry.data.description ?? "Technical research notes",
    url: withBase(`/blog/${entry.id}/`),
  })),
  ctf: ctfEntries.map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    summary: `${entry.data.platform}${entry.data.vulnerability_type ? ` | ${entry.data.vulnerability_type}` : ""}`,
    url: withBase(`/ctf/${entry.id}/`),
  })),
};

const tagCounts = await getTagCounts();
const terminalStats = { ctf: ctfEntries.length, blog: blogEntries.length, tags: tagCounts.length };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- CSP baseline: self-origin + data URIs for inline images. Astro hash will be injected automatically. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' https:;"
    />

    <!-- Font preloads for better LCP -->
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Kyrux Labs RSS" href={withBase("/rss.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Kyrux Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

  </head>
  <body class="min-h-screen">
    <!-- Skip-to-content -->
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-neutral-900 focus:px-3 focus:py-2 focus:text-cyan-300">
      Skip to content
    </a>

    <!-- Reading progress bar -->
    <div id="reading-progress" class="fixed left-0 top-0 z-50 h-0.5 w-0 bg-cyan-400/90"></div>

    <!-- Sticky header — full-width, outside content container -->
    <header id="site-header" class="sticky top-0 z-40 w-full border-b border-transparent transition-all duration-300">
      <div class="absolute inset-0 bg-neutral-950/85 backdrop-blur-md"></div>
      <div class="relative mx-auto flex max-w-5xl items-center gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a
          href={withBase("/")}
          class="shrink-0 text-lg font-semibold tracking-tight text-neutral-100 hover:text-cyan-300 transition-colors"
        >
          kyrux
        </a>
        <nav aria-label="Main Navigation" class="min-w-0 flex-1">
          <ul class="flex min-w-0 items-center gap-1 overflow-x-auto whitespace-nowrap text-sm [scrollbar-width:none]">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noreferrer" : undefined}
                    class:list={[
                      "relative rounded-md px-2 py-1 text-neutral-400 hover:text-cyan-300 transition-colors",
                      !link.external && currentPath === new URL(link.href, Astro.url).pathname
                        ? "text-cyan-300 after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:w-1/2 after:rounded-full after:bg-cyan-400"
                        : ""
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="ml-auto flex shrink-0 items-center gap-2">
          <ThemeToggle />
          <button id="terminal-toggle" type="button" class="inline-flex items-center gap-1.5 rounded-md border border-neutral-700/80 bg-neutral-900/80 px-2.5 py-1.5 font-mono text-xs text-neutral-300 hover:border-cyan-500 hover:text-cyan-300 hover:bg-neutral-800/80 transition-colors" title="Open terminal (Ctrl+`)">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            <span class="hidden sm:inline">terminal</span>
          </button>
        </div>
      </div>
    </header>

    <div class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-4 py-5 sm:px-6 lg:px-8">

      <main id="content" class="flex-1">
        <slot />
      </main>

      <footer class="mt-14 border-t border-neutral-800 pt-6 text-sm text-neutral-500">
        <p>&copy; {new Date().getFullYear()} Kyrux &mdash; Vu Trong Quoc Khanh.</p>
      </footer>
    </div>

    <!-- Interactive islands (bare Astro components – scripts auto-bundled by Astro) -->
    <CopyButton />
    <ImageLightbox />
    <Terminal />
    <CommandPalette />
    <BackToTop />

    <!-- Cmd+K hint (shows on hover/press) -->
    <div id="cmdk-hint" class="fixed bottom-6 left-6 z-40 hidden items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/95 px-3 py-2 text-xs text-neutral-500 backdrop-blur-sm lg:flex" style="font-family: var(--font-mono);">
      <kbd class="rounded border border-neutral-700 bg-neutral-800 px-1.5 py-0.5 text-neutral-300">Cmd+K</kbd>
      <span>Search</span>
    </div>

    <!-- Terminal data payload (read by Terminal island) -->
    <script is:inline id="terminal-data" type="application/json" set:html={JSON.stringify(terminalItems)}></script>

    <script is:inline id="terminal-stats" type="application/json" set:html={JSON.stringify(terminalStats)}></script>

    <!-- Reading progress bar script (tiny, kept inline for zero-overhead) -->
    <script is:inline>
      const progressBar = document.getElementById("reading-progress");
      const updateProgress = () => {
        if (!progressBar) return;
        const scrollTop = window.scrollY;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollHeight > 0 ? Math.min(100, (scrollTop / scrollHeight) * 100) : 0;
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    </script>

    <!-- Easter eggs: konami code, glitch -->
    <script is:inline>
      (function() {
        // Konami code: ↑↑↓↓←→←→BA
        const konami = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
        let pos = 0;

        document.addEventListener("keydown", function(e) {
          if (e.key === konami[pos]) {
            pos++;
            if (pos === konami.length) {
              document.body.style.transition = "filter 0.15s";
              document.body.style.filter = "hue-rotate(180deg)";
              setTimeout(function() {
                document.body.style.filter = "";
                setTimeout(function() {
                  document.body.style.transition = "";
                }, 150);
              }, 200);
              console.log("%c🛡️ Kyrux Labs %c— If you know the enemy and know yourself, you need not fear the result of a hundred battles.",
                "color: #06b6d4; font-size: 16px; font-weight: bold;",
                "color: #a3a3a3;");
              pos = 0;
            }
          } else {
            pos = 0;
          }
        });

        // Glitch hover on the logo (random jitter)
        var logo = document.querySelector('a[href="/"], a[href$="/"]');
        if (logo) {
          var glitchTimer = null;
          logo.addEventListener("mouseenter", function() {
            var el = logo;
            var count = 0;
            glitchTimer = setInterval(function() {
              if (count >= 6) { clearInterval(glitchTimer); el.style.transform = ""; return; }
              var dx = (Math.random() - 0.5) * 3;
              var dy = (Math.random() - 0.5) * 2;
              el.style.transform = "translate(" + dx + "px, " + dy + "px)";
              count++;
            }, 50);
          });
          logo.addEventListener("mouseleave", function() {
            if (glitchTimer) clearInterval(glitchTimer);
            logo.style.transform = "";
          });
        }
      })();
    </script>

    <!-- Navbar scroll shadow -->
    <script is:inline>
      (function() {
        var header = document.getElementById("site-header");
        if (!header) return;
        window.addEventListener("scroll", function() {
          var scrolled = window.scrollY > 8;
          header.style.borderBottomColor = scrolled ? "rgba(38,38,38,0.6)" : "transparent";
          header.style.boxShadow = scrolled ? "0 1px 2px 0 rgba(0,0,0,0.3)" : "none";
        }, { passive: true });
      })();
    </script>

    <!-- Scroll-reveal observer -->
    <script is:inline>
      (function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("reveal-active");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -30px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
        // Observe dynamically added .reveal elements
        new MutationObserver(() => {
          document.querySelectorAll(".reveal:not(.reveal-active)").forEach((el) => observer.observe(el));
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
